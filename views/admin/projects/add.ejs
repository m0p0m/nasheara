<h1 class="text-3xl font-bold text-[#1E293B] mb-2">افزودن نمونه‌کار</h1>
<p class="text-[#6B7280] mb-8">اطلاعات پروژه اجراشده را وارد کنید.</p>

<form action="/admin/projects/add" method="POST" enctype="multipart/form-data" class="space-y-8">
    <div class="card-modern">
        <h2 class="text-xl font-semibold mb-6">اطلاعات اصلی</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
                <label for="title" class="block text-sm font-semibold">عنوان *</label>
                <input id="title" name="title" required class="input-field" placeholder="مثلاً اجرای کاشی حیاط ویلای یزد">
            </div>
            <div class="space-y-2">
                <label for="slug" class="block text-sm font-semibold">نامک (Slug)</label>
                <input id="slug" name="slug" dir="ltr" class="input-field" placeholder="خالی بگذارید تا خودکار ساخته شود">
            </div>
            <div class="space-y-2 md:col-span-2">
                <label for="location" class="block text-sm font-semibold">موقعیت یا نوع فضا</label>
                <input id="location" name="location" class="input-field" placeholder="مثلاً یزد، حیاط ویلا">
            </div>
            <div class="space-y-2 md:col-span-2">
                <label for="description" class="block text-sm font-semibold">توضیحات</label>
                <textarea id="description" name="description" rows="7" class="input-field resize-y"></textarea>
            </div>
        </div>
    </div>
    <div class="card-modern">
        <h2 class="text-xl font-semibold mb-6">تصاویر پروژه</h2>
        <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2"><label for="coverImage" class="block text-sm font-semibold">تصویر کاور</label><input type="file" id="coverImage" name="coverImage" accept="image/*" class="input-field border-dashed"></div>
            <div class="space-y-2"><label for="galleryImages" class="block text-sm font-semibold">گالری (حداکثر ۵ تصویر)</label><input type="file" id="galleryImages" name="galleryImages" accept="image/*" multiple class="input-field border-dashed"></div>
        </div>
    </div>
    <div class="card-modern">
        <h2 class="text-xl font-semibold mb-2">محصولات مرتبط</h2>
        <p class="text-sm text-slate-500 mb-5">محصولات استفاده‌شده در این پروژه را انتخاب کنید.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <% products.forEach(product => { %>
                <label class="flex items-center gap-3 p-3 border rounded-xl hover:bg-slate-50">
                    <input type="checkbox" name="relatedProductIds" value="<%= product.id %>" class="w-4 h-4">
                    <span class="text-sm"><%= product.name %></span>
                </label>
            <% }); %>
        </div>
    </div>
    <div class="flex justify-end gap-3"><a href="/admin/projects" class="btn-secondary">انصراف</a><button class="btn-primary">ذخیره نمونه‌کار</button></div>
</form>
