<h1 class="text-3xl font-bold text-[#1E293B] mb-2">ویرایش نمونه‌کار: <%= project.title %></h1>
<p class="text-[#6B7280] mb-8">اطلاعات و تصاویر پروژه را به‌روزرسانی کنید.</p>

<form action="/admin/projects/edit/<%= project.id %>" method="POST" enctype="multipart/form-data" class="space-y-8">
    <div class="card-modern">
        <h2 class="text-xl font-semibold mb-6">اطلاعات اصلی</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2"><label for="title" class="block text-sm font-semibold">عنوان *</label><input id="title" name="title" value="<%= project.title %>" required class="input-field"></div>
            <div class="space-y-2"><label for="slug" class="block text-sm font-semibold">نامک (Slug)</label><input id="slug" name="slug" dir="ltr" value="<%= project.slug || '' %>" class="input-field"></div>
            <div class="space-y-2 md:col-span-2"><label for="location" class="block text-sm font-semibold">موقعیت یا نوع فضا</label><input id="location" name="location" value="<%= project.location || '' %>" class="input-field"></div>
            <div class="space-y-2 md:col-span-2"><label for="description" class="block text-sm font-semibold">توضیحات</label><textarea id="description" name="description" rows="7" class="input-field resize-y"><%= project.description || '' %></textarea></div>
        </div>
    </div>
    <div class="card-modern">
        <h2 class="text-xl font-semibold mb-6">تصاویر پروژه</h2>
        <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-3">
                <% if (project.coverImage) { %><img src="<%= project.coverImage %>" alt="<%= project.title %>" class="w-40 h-28 object-cover rounded-xl"><% } %>
                <label for="coverImage" class="block text-sm font-semibold">جایگزینی کاور</label><input type="file" id="coverImage" name="coverImage" accept="image/*" class="input-field border-dashed">
            </div>
            <div class="space-y-3">
                <div class="flex flex-wrap gap-2"><% (project.galleryImages || []).forEach(image => { %><img src="<%= image %>" alt="تصویر گالری" class="w-20 h-20 object-cover rounded-lg"><% }); %></div>
                <label for="galleryImages" class="block text-sm font-semibold">افزودن تصاویر گالری</label><input type="file" id="galleryImages" name="galleryImages" accept="image/*" multiple class="input-field border-dashed">
            </div>
        </div>
    </div>
    <div class="card-modern">
        <h2 class="text-xl font-semibold mb-5">محصولات مرتبط</h2>
        <% const selectedProducts = project.relatedProductIds || []; %>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <% products.forEach(product => { %>
                <label class="flex items-center gap-3 p-3 border rounded-xl hover:bg-slate-50">
                    <input type="checkbox" name="relatedProductIds" value="<%= product.id %>" <%= selectedProducts.includes(product.id) || selectedProducts.includes(product.slug) ? 'checked' : '' %> class="w-4 h-4">
                    <span class="text-sm"><%= product.name %></span>
                </label>
            <% }); %>
        </div>
    </div>
    <div class="flex justify-end gap-3"><a href="/admin/projects" class="btn-secondary">انصراف</a><button class="btn-primary">ذخیره تغییرات</button></div>
</form>
