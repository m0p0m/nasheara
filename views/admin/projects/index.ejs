<div class="mb-8 flex flex-col sm:flex-row justify-between items-start gap-4">
    <div>
        <h1 class="text-4xl font-bold text-slate-900 mb-2">مدیریت نمونه‌کارها</h1>
        <p class="text-slate-500">پروژه‌های اجراشده را ثبت و مدیریت کنید.</p>
    </div>
    <a href="/admin/projects/add" class="btn-primary">افزودن نمونه‌کار جدید</a>
</div>

<div class="card-modern !p-0 overflow-hidden">
    <% if (projects && projects.length) { %>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-4 text-right text-xs font-bold">تصویر</th>
                        <th class="px-6 py-4 text-right text-xs font-bold">عنوان</th>
                        <th class="px-6 py-4 text-right text-xs font-bold">موقعیت</th>
                        <th class="px-6 py-4 text-right text-xs font-bold">تاریخ ثبت</th>
                        <th class="px-6 py-4 text-center text-xs font-bold">عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% projects.forEach(project => { %>
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-4">
                                <div class="w-20 h-16 rounded-xl overflow-hidden bg-slate-100">
                                    <% if (project.coverImage) { %>
                                        <img src="<%= project.coverImage %>" alt="<%= project.title %>" class="w-full h-full object-cover">
                                    <% } %>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <p class="font-semibold text-slate-900"><%= project.title %></p>
                                <p class="text-xs text-slate-500 mt-1" dir="ltr"><%= project.slug %></p>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600"><%= project.location || '—' %></td>
                            <td class="px-6 py-4 text-sm text-slate-500"><%= new Date(project.createdAt).toLocaleDateString('fa-IR') %></td>
                            <td class="px-6 py-4">
                                <div class="flex justify-center gap-2">
                                    <a href="/admin/projects/edit/<%= project.id %>" class="btn-secondary !py-2 !px-3 text-xs">ویرایش</a>
                                    <form action="/admin/projects/delete/<%= project.id %>" method="POST" onsubmit="return confirm('این نمونه‌کار حذف شود؟');">
                                        <button class="px-3 py-2 text-xs text-red-600 bg-red-50 rounded-lg hover:bg-red-600 hover:text-white">حذف</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="text-center py-20">
            <h2 class="text-2xl font-bold text-slate-900 mb-3">هنوز نمونه‌کاری ثبت نشده است</h2>
            <a href="/admin/projects/add" class="btn-primary mt-5">افزودن اولین نمونه‌کار</a>
        </div>
    <% } %>
</div>
