<h1 class="text-3xl font-bold text-[#1E293B] mb-2"><%= t('auto.k_fc321cb59c64') %></h1>
<p class="text-[#6B7280] mb-8"><%= t('auto.k_a410a6d457ff') %></p>

<form action="/admin/products/add" method="POST" enctype="multipart/form-data" class="space-y-8">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Main Product Info -->
    <div class="card-modern">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-semibold text-[#1E293B]"><%= t('auto.k_4e703f2368ec') %></h2>
                <p class="text-sm text-[#6B7280] mt-1"><%= t('auto.k_d57e8aabcde2') %></p>
            </div>
            <div class="hidden lg:flex items-center gap-2 text-xs text-[#2563EB] bg-[#F0F9FF] px-3 py-1 rounded-full">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <%= t('auto.k_2bd2d577705d') %>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
                <label for="name" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_430308963fce') %> *</label>
                <input type="text" id="name" name="translations[fa][name]" required class="input-field">
            </div>
            <div class="space-y-2">
                <label for="slug" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_3a580488f409') %></label>
                <input type="text" id="slug" name="slug" dir="ltr" placeholder="<%= t('auto.k_95338bc2e5ae') %>" class="input-field">
                <p class="text-xs text-[#6B7280]"><%= t('auto.k_90970838d35b') %></p>
            </div>
            <div class="space-y-2">
                <label for="category" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_a4dfaeb7ad8e') %> *</label>
                <select id="category" name="category" required class="w-full h-12 px-4 border-2 border-[#2563EB]/20 rounded-xl focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/20 transition-all bg-white">
                    <% categories.forEach(category => { %>
                        <option value="<%= category.name %>"><%= category.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="space-y-2 md:col-span-2 lg:col-span-1">
                <label for="stock" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_55645b2c6d92') %></label>
                <input type="number" id="stock" name="stock" min="0" placeholder="<%= t('auto.k_8862f658ab55') %>" class="input-field">
                <p class="text-xs text-[#6B7280] leading-5">
                    <%= t('auto.k_1f776f957b3a') %> <span class="font-semibold text-[#2563EB]">«<%= t('auto.k_ca2b3aa7ba1f') %></span> <%= t('auto.k_8a6037f1e56a') %> <span class="font-semibold text-red-500"><%= t('auto.k_c42b8336fca5') %></span> <%= t('auto.k_5d41be029158') %>
                </p>
            </div>
            <div class="md:col-span-2 space-y-2">
                <label for="description" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_55bbd4b9a85f') %></label>
                <textarea id="description" name="translations[fa][description]" rows="5" class="input-field resize-y" placeholder="<%= t('auto.k_4f2c2176c186') %>"></textarea>
            </div>
        </div>
    </div>

    <!-- Tile Details -->
    <div class="card-modern">
        <div class="mb-6">
            <h2 class="text-xl font-semibold text-[#1E293B]"><%= t('auto.k_c85bb2c1d9bd') %></h2>
            <p class="text-sm text-[#6B7280] mt-1"><%= t('auto.k_f3ebf772e465') %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
                <label for="patternName" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_4ddb7f5464bb') %></label>
                <input type="text" id="patternName" name="translations[fa][patternName]" placeholder="<%= t('auto.k_dbf40914b1a9') %>" class="input-field">
            </div>
            <div class="space-y-2">
                <label for="color" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_3f13b5cf1544') %></label>
                <input type="text" id="color" name="translations[fa][color]" placeholder="<%= t('auto.k_e1141a4b567c') %>" class="input-field">
            </div>
            <div class="space-y-2">
                <label for="material" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_7e4d6e47aa8b') %></label>
                <input type="text" id="material" name="translations[fa][material]" placeholder="<%= t('auto.k_1fef330442e1') %>" class="input-field">
            </div>
            <div class="space-y-2">
                <label for="dimensions" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_32624786c6df') %></label>
                <input type="text" id="dimensions" name="translations[fa][dimensions]" placeholder="<%= t('auto.k_c4694fef2535') %>" class="input-field">
            </div>
            <div class="space-y-2 md:col-span-2">
                <label for="usageArea" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_63f4397820d3') %></label>
                <input type="text" id="usageArea" name="translations[fa][usageArea]" placeholder="<%= t('auto.k_21e5b8843a0a') %>" class="input-field">
            </div>
        </div>
    </div>

    <% ['en', 'ar'].forEach(language => { %>
    <div class="card-modern" dir="<%= language === 'en' ? 'ltr' : 'rtl' %>">
        <h2 class="text-xl font-semibold mb-6"><%= t('auto.k_4ba3e969a5bb') %> <%= language === 'en' ? 'English' : t('auto.k_9970632f55af') %></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_430308963fce') %></label><input name="translations[<%= language %>][name]" class="input-field"></div>
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_4ddb7f5464bb') %></label><input name="translations[<%= language %>][patternName]" class="input-field"></div>
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_3f13b5cf1544') %></label><input name="translations[<%= language %>][color]" class="input-field"></div>
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_7e4d6e47aa8b') %></label><input name="translations[<%= language %>][material]" class="input-field"></div>
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_32624786c6df') %></label><input name="translations[<%= language %>][dimensions]" class="input-field"></div>
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_765d7912c658') %></label><input name="translations[<%= language %>][usageArea]" class="input-field"></div>
            <div class="md:col-span-2 space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_55bbd4b9a85f') %></label><textarea name="translations[<%= language %>][description]" rows="5" class="input-field resize-y"></textarea></div>
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_0f2bad2af0b2') %></label><input name="translations[<%= language %>][metaTitle]" class="input-field"></div>
            <div class="space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_88c6a2a285c8') %></label><input name="translations[<%= language %>][keywords]" class="input-field"></div>
            <div class="md:col-span-2 space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_7d6ba4bee034') %></label><textarea name="translations[<%= language %>][metaDescription]" rows="3" class="input-field resize-y"></textarea></div>
            <div class="md:col-span-2 space-y-2"><label class="block text-sm font-semibold"><%= t('auto.k_7baf717d7093') %></label><textarea name="translations[<%= language %>][specs]" rows="4" class="input-field resize-y"></textarea></div>
        </div>
    </div>
    <% }); %>

    <!-- Images -->
    <div class="card-modern">
        <div class="mb-6">
            <h2 class="text-xl font-semibold text-[#1E293B]"><%= t('auto.k_2ca319622ebe') %></h2>
            <p class="text-sm text-[#6B7280] mt-1"><%= t('auto.k_936aa446e5d6') %></p>
            <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-7 text-slate-700">
                <strong>راهنمای تصویر محصول:</strong> تصویر اصلی را با نسبت عمودی ۴:۵ و حداقل ۱۲۰۰×۱۵۰۰ پیکسل بگذارید. تصاویر گالری می‌توانند ۱۲۰۰×۱۲۰۰ یا ۱۶۰۰×۱۲۰۰ باشند. فرمت WebP یا JPG، حجم کمتر از ۵۰۰ کیلوبایت و نام توصیفی انگلیسی (مثل <span dir="ltr">green-handmade-tile.webp</span>) بهترین نتیجه را می‌دهد.
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
                <label for="mainImage" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_3a3abd101449') %></label>
                <input type="file" id="mainImage" name="mainImage" accept="image/*" class="input-field border-dashed">
                <p class="text-xs text-[#6B7280]"><%= t('auto.k_231402f6facd') %></p>
            </div>
            <div class="space-y-2">
                <label for="galleryImages" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_c324ef3a854c') %></label>
                <input type="file" id="galleryImages" name="galleryImages" accept="image/*" multiple class="input-field border-dashed">
                <p class="text-xs text-[#6B7280]"><%= t('auto.k_f306bf315df7') %></p>
            </div>
        </div>
    </div>

    <%- include('_visualizer-card') %>

    <!-- SEO -->
    <div class="card-modern">
        <div class="mb-6">
            <h2 class="text-xl font-semibold text-[#1E293B]"><%= t('auto.k_0f10eb61122f') %></h2>
            <p class="text-sm text-[#6B7280] mt-1"><%= t('auto.k_afd901c9e30c') %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
                <label for="metaTitle" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_0f2bad2af0b2') %></label>
                <input type="text" id="metaTitle" name="translations[fa][metaTitle]" class="input-field">
            </div>
            <div class="space-y-2">
                <label for="keywords" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_1fbcc4f71104') %></label>
                <input type="text" id="keywords" name="translations[fa][keywords]" class="input-field">
            </div>
        </div>
        <div class="mt-6 space-y-2">
            <label for="metaDescription" class="block text-sm font-semibold text-[#1E293B]"><%= t('auto.k_7d6ba4bee034') %></label>
            <textarea id="metaDescription" name="translations[fa][metaDescription]" rows="3" class="input-field resize-y"></textarea>
        </div>
    </div>

    <!-- Flags & Specs -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card-modern">
            <h2 class="text-xl font-semibold text-[#1E293B] mb-4"><%= t('auto.k_4b4c40dc2b49') %></h2>
            <div class="space-y-3">
                <label class="flex items-center gap-3 text-sm text-[#1E293B]">
                    <input type="checkbox" id="isNew" name="isNew" value="true" class="w-4 h-4 rounded border-[#2563EB]/30 text-[#2563EB] focus:ring-[#2563EB]">
                    <%= t('auto.k_7ef3a583ba13') %>
                </label>
                <label class="flex items-center gap-3 text-sm text-[#1E293B]">
                    <input type="checkbox" id="isBestSeller" name="isBestSeller" value="true" class="w-4 h-4 rounded border-[#2563EB]/30 text-[#2563EB] focus:ring-[#2563EB]">
                    <%= t('auto.k_4bac6559416d') %>
                </label>
            </div>
        </div>
        <div class="card-modern">
            <h2 class="text-xl font-semibold text-[#1E293B] mb-4"><%= t('auto.k_75d94d0a1292') %></h2>
            <label for="specs" class="block text-sm font-semibold text-[#1E293B] mb-2"><%= t('auto.k_a936bc3fdf4a') %></label>
            <textarea id="specs" name="translations[fa][specs]" rows="5" class="input-field resize-y"></textarea>
            <p class="text-xs text-[#6B7280] mt-2"><%= t('auto.k_3a1555c441ca') %> <code><%= t('auto.k_df4b9d614141') %></code> — <%= t('auto.k_3fe9e533e50c') %></p>
        </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-end gap-3">
        <a href="/admin/products" class="btn-secondary h-12">
            <%= t('auto.k_106dfb4e0f62') %>
        </a>
        <button type="submit" class="btn-primary px-8 h-12">
            <%= t('auto.k_b10a2c6eed4c') %>
        </button>
    </div>
</form>
