<%
    const vp = typeof product !== 'undefined' && product ? product : {};
    const shapes = typeof tileShapes !== 'undefined' ? tileShapes : {};
    const kinds = typeof tileKinds !== 'undefined' ? tileKinds : {};
    let rawVariants = vp.tileVariants;
    if (typeof rawVariants === 'string') { try { rawVariants = JSON.parse(rawVariants); } catch (e) { rawVariants = null; } }
    const cutoutVariants = (Array.isArray(rawVariants) ? rawVariants : [])
        .filter(v => v && typeof v.cutout === 'string')
        .map(v => ({ label: String(v.label || ''), cutout: v.cutout }));
    if (!cutoutVariants.length && vp.tileCutout) cutoutVariants.push({ label: '', cutout: vp.tileCutout });
    const cutoutSources = [vp.mainImage].concat(Array.isArray(vp.galleryImages) ? vp.galleryImages : []).filter(Boolean);
%>
<!-- Visualizer -->
<div class="card-modern" data-cutout-tool
     data-csrf="<%= csrfToken %>"
     data-variants="<%= JSON.stringify(cutoutVariants) %>"
     data-sources="<%= JSON.stringify(cutoutSources) %>">
    <div class="mb-6">
        <h2 class="text-xl font-semibold text-[#1E293B]">شبیه‌ساز فضا</h2>
        <p class="text-sm text-[#6B7280] mt-1 leading-7">برای اینکه محصول در شبیه‌ساز سایت بیاید، باید حداقل یک «تصویر کاشی» داشته باشد: عکس روبه‌روی <em>یک</em> کاشی با پس‌زمینه و حفره‌های شفاف. لازم نیست آن را جداگانه بسازید — با ابزار زیر مستقیماً از <strong>تصویر اصلی یا گالری همین محصول</strong> ساخته می‌شود و رنگ واقعی محصول حفظ می‌شود. برای هر رنگ یک تصویر بسازید تا مشتری بتواند رنگ‌ها را روی دیوار عوض یا ترکیب کند.</p>
    </div>

    <div class="space-y-2 mb-6">
        <label for="tileKind" class="block text-sm font-semibold text-[#1E293B]">نوع محصول در شبیه‌ساز</label>
        <select id="tileKind" name="tileKind" class="input-field">
            <option value="">تشخیص خودکار (اگر در نام یا دسته «بلوک» باشد → بلوک)</option>
            <% Object.entries(kinds).forEach(([key, kind]) => { %>
                <option value="<%= key %>" <%= vp.tileKind === key ? 'selected' : '' %>><%= kind.label %></option>
            <% }); %>
        </select>
        <p class="text-xs text-[#6B7280]">کاشی فقط روی صحنه‌های «دیوار» نصب می‌شود؛ بلوک مشبک فقط در صحنه‌های «پارتیشن / نما» خودِ دیوار را می‌سازد و از لای حفره‌هایش پشت آن دیده می‌شود.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
            <label for="tileShape" class="block text-sm font-semibold text-[#1E293B]">شکل کاشی</label>
            <select id="tileShape" name="tileShape" class="input-field" data-cutout-shape>
                <option value="">تشخیص خودکار (از روی تصویر کاشی)</option>
                <% Object.entries(shapes).forEach(([key, shape]) => { %>
                    <option value="<%= key %>" <%= vp.tileShape === key ? 'selected' : '' %>><%= shape.label %></option>
                <% }); %>
            </select>
            <p class="text-xs text-[#6B7280]" data-cutout-shape-msg>بلوک‌های مشبک (طرح موج، چهارپر…) «مربع» هستند؛ حفره‌ها از شفافیت تصویر می‌آیند، نه از شکل.</p>
        </div>
        <div class="space-y-2">
            <label for="tileWidthCm" class="block text-sm font-semibold text-[#1E293B]">عرض واقعی کاشی (سانتی‌متر)</label>
            <input type="number" step="0.1" min="1" max="200" id="tileWidthCm" name="tileWidthCm" value="<%= vp.tileWidthCm || '' %>" class="input-field" placeholder="مثلاً ۲۰">
            <p class="text-xs text-[#6B7280]">ارتفاع از نسبت خود تصویر کاشی محاسبه می‌شود تا کاشی هیچ‌وقت کشیده نشود.</p>
        </div>
    </div>

    <input type="hidden" name="tileVariants" value="<%= JSON.stringify(cutoutVariants) %>" data-cutout-field>

    <div class="mt-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
            <h3 class="text-base font-semibold text-[#1E293B]">رنگ‌ها / تصاویر کاشی در شبیه‌ساز</h3>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn-primary !py-2 !px-3 text-xs" data-cutout-open>+ ساخت از تصویر محصول</button>
                <label class="btn-secondary !py-2 !px-3 text-xs cursor-pointer">+ آپلود PNG آماده<input type="file" accept="image/png,image/webp" class="sr-only" data-cutout-ready></label>
            </div>
        </div>
        <div class="cutout-list" data-cutout-list></div>
        <p class="text-xs text-[#6B7280] mt-2">اولین مورد، رنگ پیش‌فرض شبیه‌ساز است (با ★ جابه‌جا کنید). تغییرات با دکمهٔ ذخیرهٔ محصول ثبت می‌شوند.</p>
    </div>

    <!-- Cut-out maker -->
    <div class="cutout-maker mt-6" data-cutout-maker hidden>
        <div class="flex flex-wrap items-center gap-2 mb-3" data-cutout-sources></div>
        <p class="text-sm text-slate-600 leading-7 mb-3">
            <strong>۱.</strong> چهار دایره را روی چهار گوشهٔ <strong>رویهٔ جلویی</strong> کاشی بگذارید (بالا-چپ، بالا-راست، پایین-راست، پایین-چپ) — نه روی بدنهٔ کناری. برای کاشی لوزی، روی چهار رأس (بالا، راست، پایین، چپ).
            <strong>۲.</strong> در پیش‌نمایش، حفره‌ها و پس‌زمینه باید شطرنجی (شفاف) شوند؛ اگر جایی درست نشد با «حساسیت» تنظیم کنید یا ابزار «کلیک: شفاف کن / برگردان» را روی همان قسمت پیش‌نمایش بزنید.
        </p>
        <div class="cutout-maker__grid">
            <div class="cutout-maker__stage" data-cutout-stage>
                <img alt="" data-cutout-img>
                <svg data-cutout-svg aria-hidden="true"></svg>
                <canvas class="scene-editor__loupe" width="160" height="160" data-cutout-loupe hidden></canvas>
            </div>
            <div class="space-y-3">
                <div class="cutout-maker__preview-wrap">
                    <canvas class="cutout-maker__preview" data-cutout-preview></canvas>
                    <canvas class="cutout-maker__repeat" data-cutout-repeat></canvas>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <label class="text-xs text-slate-600">عرض (سانتی‌متر)<input type="number" min="1" step="0.1" value="20" class="input-field !py-1.5" data-cutout-w></label>
                    <label class="text-xs text-slate-600">ارتفاع (سانتی‌متر)<input type="number" min="1" step="0.1" value="20" class="input-field !py-1.5" data-cutout-h></label>
                </div>
                <label class="flex items-center gap-2 text-xs text-slate-700"><input type="checkbox" checked data-cutout-key> شفاف کردن پس‌زمینه و حفره‌ها</label>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                    رنگ پس‌زمینه <span class="cutout-maker__swatch" data-cutout-bg></span>
                    <button type="button" class="scene-tool !py-1 !px-2" data-cutout-tool="pick">انتخاب از پیش‌نمایش</button>
                </div>
                <label class="block text-xs text-slate-600">حساسیت <input type="range" min="4" max="120" value="38" class="w-full" data-cutout-tol></label>
                <label class="block text-xs text-slate-600">حداقل اندازهٔ حفره <input type="range" min="0" max="4" step="0.1" value="0.6" class="w-full" data-cutout-min></label>
                <label class="block text-xs text-slate-600">برش لبه <input type="range" min="0" max="4" step="0.25" value="0.5" class="w-full" data-cutout-inset></label>
                <div class="flex flex-wrap gap-2">
                    <button type="button" class="scene-tool" data-cutout-tool="clear">کلیک: شفاف کن</button>
                    <button type="button" class="scene-tool" data-cutout-tool="restore">کلیک: برگردان</button>
                    <button type="button" class="btn-secondary !py-1 !px-2 text-xs" data-cutout-seeds-reset>حذف کلیک‌ها</button>
                </div>
                <label class="block text-xs text-slate-600">نام رنگ<input type="text" maxlength="60" class="input-field !py-1.5" placeholder="مثلاً نارنجی" data-cutout-label></label>
                <p class="text-xs text-emerald-700" data-cutout-status></p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" class="btn-primary !py-2 !px-3 text-xs" data-cutout-add>افزودن این رنگ</button>
                    <button type="button" class="btn-secondary !py-2 !px-3 text-xs" data-cutout-all title="برای عکس‌هایی که همه از یک زاویه گرفته شده‌اند">ساخت برای همهٔ تصاویر با همین گوشه‌ها</button>
                    <button type="button" class="btn-secondary !py-2 !px-3 text-xs" data-cutout-close>بستن</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="<%= asset('/js/admin-cutout.js') %>" defer></script>
