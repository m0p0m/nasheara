<div class="mb-8">
    <div class="flex flex-col xl:flex-row justify-between items-start gap-4 mb-6">
        <div>
            <h1 class="text-4xl font-bold text-slate-900 mb-2"><%= t('auto.k_52d769d792f0') %></h1>
            <p class="text-slate-500"><%= t('auto.k_242cfbe526a3') %></p>
        </div>
        <a href="/admin/products/add" class="inline-flex items-center gap-2 btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <%= t('auto.k_fc321cb59c64') %>
        </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="card-modern">
            <p class="text-sm text-slate-500"><%= t('auto.k_2133ee66eee0') %></p>
            <p class="mt-3 text-3xl font-bold text-slate-900"><%= total %></p>
        </div>
        <div class="card-modern">
            <p class="text-sm text-slate-500"><%= t('auto.k_e3b971a3f3b0') %></p>
            <p class="mt-3 text-xl font-semibold text-slate-900"><%= (q || categoryId) ? t('auto.k_132a80572443') : t('auto.k_4e19ecc30a22') %></p>
        </div>
        <div class="card-modern">
            <p class="text-sm text-slate-500"><%= t('auto.k_420d45935eec') %></p>
            <p class="mt-3 text-3xl font-bold text-slate-900"><%= withoutImage %></p>
        </div>
    </div>
    <!-- Search + category filter -->
    <form action="/admin/products" method="GET" class="mb-4">
        <% if (categoryId) { %><input type="hidden" name="category" value="<%= categoryId %>"><% } %>
        <div class="flex gap-3">
            <input type="search" name="q" value="<%= q %>" placeholder="<%= t('auto.k_04dfa6055959') %>" class="input-field h-12">
            <button class="h-12 px-6 bg-slate-50 text-slate-700 rounded-xl hover:shadow-lg transition-all"><%= t('auto.k_1fc039e00500') %></button>
            <% if (q || categoryId) { %>
                <a href="/admin/products" class="h-12 px-4 inline-flex items-center text-[#2563EB] hover:underline"><%= t('auto.k_ac3d6175fd16') %></a>
            <% } %>
        </div>
    </form>
    <div class="flex flex-wrap gap-2 mb-2">
        <% const allCount = Object.values(categoryCounts).reduce((sum, n) => sum + n, 0); %>
        <a href="<%= buildQuery({ category: '', page: 1 }) %>" class="px-3 py-1.5 rounded-full text-sm border transition-colors <%= !categoryId ? 'bg-[#2563EB] text-white border-[#2563EB]' : 'bg-white text-slate-600 border-slate-200 hover:border-[#2563EB]' %>">
            همه <span class="opacity-75">(<%= allCount %>)</span>
        </a>
        <% categories.forEach(cat => { %>
            <a href="<%= buildQuery({ category: cat.id, page: 1 }) %>" class="px-3 py-1.5 rounded-full text-sm border transition-colors <%= categoryId === cat.id ? 'bg-[#2563EB] text-white border-[#2563EB]' : 'bg-white text-slate-600 border-slate-200 hover:border-[#2563EB]' %>">
                <%= cat.name %> <span class="opacity-75">(<%= categoryCounts[cat.id] || 0 %>)</span>
            </a>
        <% }); %>
        <% if (categoryCounts['']) { %>
            <span class="px-3 py-1.5 rounded-full text-sm bg-amber-50 text-amber-700 border border-amber-200">بدون دسته (<%= categoryCounts[''] %>)</span>
        <% } %>
    </div>
</div>

<div class="card-modern !p-0 overflow-hidden">
    <% if (products && products.length > 0) { %>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50 text-slate-700">
                    <tr>
                        <th class="px-6 py-4 text-right text-xs font-bold text-slate-700 uppercase tracking-wider"><%= t('auto.k_de5560842bdf') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-slate-700 uppercase tracking-wider"><%= t('auto.k_430308963fce') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-slate-700 uppercase tracking-wider"><%= t('auto.k_a4dfaeb7ad8e') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-slate-700 uppercase tracking-wider"><%= t('auto.k_55645b2c6d92') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-slate-700 uppercase tracking-wider"><%= t('auto.k_55518965c603') %></th>
                        <th class="px-6 py-4 text-center text-xs font-bold text-slate-700 uppercase tracking-wider"><%= t('auto.k_8d1cc546f412') %></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% products.forEach(product => { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-100">
                                    <% if (product.mainImage) { %>
                                        <img src="<%= product.mainImage %>" alt="<%= product.name %>" width="64" height="64" loading="lazy" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center bg-gray-200">
                                            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                        </div>
                                    <% } %>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-semibold text-[#1E293B]"><%= product.name %></div>
                                <div class="text-xs text-[#6B7280] mt-1 ltr-text"><%= product.patternName && product.patternName !== product.name ? product.patternName + ' · ' : '' %>/<%= product.slug %></div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-3 py-1 text-xs font-medium bg-[#F0F9FF] text-[#2563EB] rounded-full"><%= product.category || t('auto.k_3145305ff0ff') %></span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <%
                                    const hasNumericStock = typeof product.stock === 'number' && !Number.isNaN(product.stock);
                                    const stockValue = hasNumericStock ? product.stock : null;
                                %>
                                <% if (stockValue === null) { %>
                                    <span class="px-3 py-1 text-xs font-medium bg-[#F0F9FF] text-[#2563EB] rounded-full"><%= t('auto.k_5ad7cf172cdb') %></span>
                                <% } else if (stockValue > 0) { %>
                                    <span class="px-3 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full"><%= stockValue %> <%= t('auto.k_8bc43dce18cf') %></span>
                                <% } else { %>
                                    <span class="px-3 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full"><%= t('auto.k_c42b8336fca5') %></span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex gap-2">
                                    <% if (product.isNew) { %>
                                        <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-700 rounded"><%= t('auto.k_64dfbb8da93a') %></span>
                                    <% } %>
                                    <% if (product.isBestSeller) { %>
                                        <span class="px-2 py-1 text-xs font-medium bg-orange-100 text-orange-700 rounded"><%= t('auto.k_122eb1e9248c') %></span>
                                    <% } %>
                                    <% if (product.tileCutout) { %>
                                        <span class="px-2 py-1 text-xs font-medium bg-emerald-100 text-emerald-700 rounded" title="تصویر PNG دارد و در شبیه‌ساز نمایش داده می‌شود">شبیه‌ساز</span>
                                    <% } %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <a href="/admin/products/edit/<%= product.id %>" class="btn-secondary !py-2 !px-3 text-xs">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                        <%= t('auto.k_ac60ae7a6877') %>
                                    </a>
                                    <form action="/admin/products/delete/<%= product.id %>" method="POST" class="inline" data-confirm="<%= t('auto.k_770d0e690ef2') %>">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-600 hover:text-white transition-all duration-300">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            <%= t('auto.k_2d2bbdc2d694') %>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% if (pageCount > 1) { %>
        <nav class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-slate-200 bg-slate-50" aria-label="صفحه‌بندی">
            <span class="text-sm text-slate-500">صفحهٔ <%= page %> از <%= pageCount %> — <%= total %> محصول</span>
            <div class="flex items-center gap-1">
                <% if (page > 1) { %><a class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-sm hover:border-[#2563EB]" href="<%= buildQuery({ page: page - 1 }) %>">قبلی</a><% } %>
                <% const win = []; for (let i = Math.max(1, page - 2); i <= Math.min(pageCount, page + 2); i++) win.push(i); %>
                <% if (win[0] > 1) { %><a class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-sm" href="<%= buildQuery({ page: 1 }) %>">1</a><% if (win[0] > 2) { %><span class="px-1 text-slate-400">…</span><% } %><% } %>
                <% win.forEach(i => { %>
                    <a class="px-3 py-1.5 rounded-lg border text-sm <%= i === page ? 'bg-[#2563EB] text-white border-[#2563EB]' : 'border-slate-200 bg-white hover:border-[#2563EB]' %>" href="<%= buildQuery({ page: i }) %>" <%= i === page ? 'aria-current="page"' : '' %>><%= i %></a>
                <% }); %>
                <% if (win[win.length - 1] < pageCount) { %><% if (win[win.length - 1] < pageCount - 1) { %><span class="px-1 text-slate-400">…</span><% } %><a class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-sm" href="<%= buildQuery({ page: pageCount }) %>"><%= pageCount %></a><% } %>
                <% if (page < pageCount) { %><a class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-sm hover:border-[#2563EB]" href="<%= buildQuery({ page: page + 1 }) %>">بعدی</a><% } %>
            </div>
        </nav>
        <% } %>
    <% } else { %>
        <div class="text-center py-20">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#F0F9FF] mb-6">
                <svg class="w-10 h-10 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#1E293B] mb-4"><%= t('auto.k_eb95102af9f8') %></h3>
            <p class="text-[#6B7280] mb-8"><%= t('auto.k_c7a765f8063d') %></p>
            <a href="/admin/products/add" class="btn-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <%= t('auto.k_8eb8f753256f') %>
            </a>
        </div>
    <% } %>
</div>
