<div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-[#1E293B]"><%= t('auto.k_99405c6e6461') %></h2>
            <p class="text-slate-500 mt-1"><%= t('auto.k_e46746604a7d') %></p>
        </div>
    </div>

    <div class="card-modern !p-0 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-6 py-4 font-bold text-slate-700"><%= t('auto.k_c9ce1c290c42') %></th>
                        <th class="px-6 py-4 font-bold text-slate-700"><%= t('auto.k_f1ad423d68cf') %></th>
                        <th class="px-6 py-4 font-bold text-slate-700"><%= t('auto.k_66e12db8fdb6') %></th>
                        <th class="px-6 py-4 font-bold text-slate-700"><%= t('auto.k_8d1cc546f412') %></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (subscribers && subscribers.length > 0) { %>
                        <% subscribers.forEach((sub, index) => { %>
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 text-slate-600"><%= index + 1 %></td>
                                <td class="px-6 py-4 text-slate-900 font-medium"><%= sub.email %></td>
                                <td class="px-6 py-4 text-slate-600 ltr-text">
                                    <%= new Date(sub.subscribedAt).toLocaleDateString('fa-IR') %>
                                </td>
                                <td class="px-6 py-4">
                                    <form action="/admin/subscribers/delete/<%= sub.id %>" method="POST" onsubmit="return confirm('<%= t('auto.k_91692ccf1edd') %>')">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="text-red-600 hover:text-red-800 transition-colors">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="3" class="px-6 py-12 text-center text-slate-500">
                                <%= t('auto.k_a519e2de391e') %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
