<h1 class="text-3xl font-bold mb-6">Edit Category: <%= category.name %></h1>

<form action="/admin/categories/edit/<%= category.id %>" method="POST" enctype="multipart/form-data" class="bg-white p-8 rounded-lg shadow-md max-w-lg mx-auto">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="mb-4">
        <label for="name" class="block text-gray-700 font-bold mb-2">Category Name:</label>
        <input type="text" id="name" name="name" value="<%= category.name %>" required class="w-full px-3 py-2 border rounded">
    </div>
    <div class="mb-6">
        <label for="description" class="block text-gray-700 font-bold mb-2">Description:</label>
        <textarea id="description" name="description" rows="4" class="w-full px-3 py-2 border rounded"><%= category.description %></textarea>
    </div>
    <div class="mb-6">
        <label class="block text-gray-700 font-bold mb-2"><%= t('auto.k_ff3bc603142b') %></label>
        <% if (category.mainImage) { %>
            <div class="mb-3">
                <img src="<%= category.mainImage %>" alt="<%= category.name %>" class="w-28 h-28 object-cover rounded-md border">
            </div>
        <% } else { %>
            <div class="mb-3 text-sm text-gray-500"><%= t('auto.k_6deb9571d9ba') %></div>
        <% } %>
        <label for="mainImage" class="block text-gray-700 font-bold mb-2"><%= t('auto.k_f5d2856397f1') %></label>
        <input type="file" id="mainImage" name="mainImage" accept="image/*" class="w-full px-3 py-2 border rounded">
    </div>
    <div class="text-right">
        <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded">Update Category</button>
    </div>
</form>
