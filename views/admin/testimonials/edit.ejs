<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 mb-2">ویرایش نظر</h1>
    <p class="text-slate-500"><%= testimonial.name %></p>
</div>

<form action="/admin/testimonials/edit/<%= testimonial.id %>" method="POST" class="card-modern max-w-3xl">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
            <label for="t-name" class="block text-sm font-semibold text-slate-700 mb-2">نام مشتری *</label>
            <input id="t-name" name="name" type="text" required maxlength="191" class="input-field" value="<%= testimonial.name %>">
        </div>
        <div>
            <label for="t-location" class="block text-sm font-semibold text-slate-700 mb-2">شهر / پروژه</label>
            <input id="t-location" name="location" type="text" maxlength="191" class="input-field" value="<%= testimonial.location || '' %>">
        </div>
        <div>
            <label for="t-rating" class="block text-sm font-semibold text-slate-700 mb-2">امتیاز</label>
            <select id="t-rating" name="rating" class="input-field">
                <% [5, 4, 3, 2, 1].forEach(n => { %><option value="<%= n %>" <%= testimonial.rating === n ? 'selected' : '' %>><%= '★'.repeat(n) %></option><% }); %>
            </select>
        </div>
    </div>
    <div class="mt-4">
        <label for="t-text" class="block text-sm font-semibold text-slate-700 mb-2">متن نظر *</label>
        <textarea id="t-text" name="text" required minlength="10" rows="4" class="input-field resize-y"><%= testimonial.text %></textarea>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-6">
        <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="published" <%= testimonial.published ? 'checked' : '' %> class="w-4 h-4"> انتشار در سایت</label>
        <label class="flex items-center gap-2 text-sm text-slate-700">ترتیب نمایش <input type="number" name="sortOrder" value="<%= testimonial.sortOrder %>" class="input-field !w-24 !py-1.5"></label>
    </div>
    <div class="mt-8 flex gap-3">
        <button type="submit" class="btn-primary">ذخیره تغییرات</button>
        <a href="/admin/testimonials" class="btn-secondary">انصراف</a>
    </div>
</form>
