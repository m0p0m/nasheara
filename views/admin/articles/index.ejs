<div class="mb-8">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-4xl font-bold text-[#1E293B] mb-2"><%= t('auto.k_6b5c7586cbef') %></h1>
            <p class="text-[#6B7280]"><%= t('auto.k_7d8da4cc3b0f') %></p>
        </div>
        <a href="/admin/articles/add" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <%= t('auto.k_8a110741f98e') %>
        </a>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
    <% if (articles && articles.length > 0) { %>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-primary">
                    <tr>
                        <th class="px-6 py-4 text-right text-xs font-bold text-white uppercase tracking-wider"><%= t('auto.k_de5560842bdf') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-white uppercase tracking-wider"><%= t('auto.k_1a9bdb20dee4') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-white uppercase tracking-wider"><%= t('auto.k_133bc3507ca3') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-white uppercase tracking-wider"><%= t('auto.k_55518965c603') %></th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-white uppercase tracking-wider"><%= t('auto.k_217c84913e05') %></th>
                        <th class="px-6 py-4 text-center text-xs font-bold text-white uppercase tracking-wider"><%= t('auto.k_8d1cc546f412') %></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% articles.forEach(article => { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-100">
                                    <% if (article.mainImage) { %>
                                        <img src="<%= article.mainImage %>" alt="<%= article.title %>" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center bg-gray-200">
                                            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                        </div>
                                    <% } %>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-semibold text-[#1E293B]"><%= article.title %></div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-xs text-[#6B7280] line-clamp-2"><%= article.excerpt ? article.excerpt.substring(0, 80) : '' %>...</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <% if (article.published) { %>
                                    <span class="px-3 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full"><%= t('auto.k_440e34607600') %></span>
                                <% } else { %>
                                    <span class="px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-full"><%= t('auto.k_7d739ea1cc07') %></span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-xs text-[#6B7280]">
                                    <%= new Date(article.createdAt).toLocaleDateString('fa-IR') %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <a href="/admin/articles/edit/<%= article.id %>" class="btn-secondary !py-2 !px-3 text-xs">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                        <%= t('auto.k_ac60ae7a6877') %>
                                    </a>
                                    <form action="/admin/articles/delete/<%= article.id %>" method="POST" class="inline" data-confirm="<%= t('auto.k_0527ff92cadf') %>">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-600 hover:text-white transition-all duration-300">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            <%= t('auto.k_2d2bbdc2d694') %>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="text-center py-20">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#F0F9FF] mb-6">
                <svg class="w-10 h-10 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#1E293B] mb-4"><%= t('auto.k_a6de383aa0f9') %></h3>
            <p class="text-[#6B7280] mb-8"><%= t('auto.k_950c4aad4bac') %></p>
            <a href="/admin/articles/add" class="btn-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <%= t('auto.k_44cd48387650') %>
            </a>
        </div>
    <% } %>
</div>

