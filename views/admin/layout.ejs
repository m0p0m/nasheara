<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen <%= locale === 'en' ? 'font-en' : 'font-fa-ar' %>">
    <div class="flex min-h-screen bg-slate-100">
        <!-- Desktop Sidebar -->
        <aside class="hidden md:flex md:flex-col md:w-72 bg-white/95 text-slate-900 p-6 shadow-lg border-l border-slate-200 md:fixed md:inset-y-0 md:right-0 overflow-y-auto">
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center shadow-md">
                        <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold"><%= t('auto.k_cae2a62bffd2') %></h1>
                        <p class="text-xs text-slate-500"><%= t('auto.k_e759f895537c') %></p>
                    </div>
                </div>
                <div class="rounded-3xl bg-slate-50 border border-[#2563EB]/10 p-4 shadow-sm">
                    <p class="text-xs uppercase tracking-[0.2em] text-primary mb-1"><%= t('auto.k_55518965c603') %></p>
                    <p class="text-sm text-slate-600"><%= t('auto.k_04a30d466479') %> 🟢</p>
                </div>
            </div>
            <nav class="space-y-2">
                <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-slate-100 text-slate-700 <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'bg-slate-100 border-r-4 border-primary' : '' %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                    <span class="font-medium"><%= t('auto.k_83cb78bbde58') %></span>
                </a>
                <a href="/admin/projects" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-slate-100 text-slate-700 <%= typeof currentPage !== 'undefined' && currentPage === 'projects' ? 'bg-slate-100 border-r-4 border-primary' : '' %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7l9-4 9 4-9 4-9-4zm0 5l9 4 9-4m-18 5l9 4 9-4"></path></svg>
                    <span class="font-medium"><%= t('auto.k_b08b4dd634e4') %></span>
                </a>
                <a href="/admin/categories" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-slate-100 text-slate-700 <%= typeof currentPage !== 'undefined' && currentPage === 'categories' ? 'bg-slate-100 border-r-4 border-primary' : '' %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 0 1 0 2.828l-7 7a2 2 0 0 1-2.828 0l-7-7A1.994 1.994 0 0 1 3 12V7a4 4 0 0 1 4-4z"></path>
                    </svg>
                    <span class="font-medium"><%= t('auto.k_fb6c30f397ae') %></span>
                </a>
                <a href="/admin/articles" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-slate-100 text-slate-700 <%= typeof currentPage !== 'undefined' && currentPage === 'articles' ? 'bg-slate-100 border-r-4 border-primary' : '' %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="font-medium"><%= t('auto.k_d41e0bc0a701') %></span>
                </a>
                <a href="/admin/consultations" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-slate-100 text-slate-700 <%= typeof currentPage !== 'undefined' && currentPage === 'consultations' ? 'bg-slate-100 border-r-4 border-primary' : '' %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                    <span class="font-medium"><%= t('auto.k_47aa49fbf0f1') %></span>
                </a>
                <a href="/admin/subscribers" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-slate-100 text-slate-700 <%= typeof currentPage !== 'undefined' && currentPage === 'subscribers' ? 'bg-slate-100 border-r-4 border-primary' : '' %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span class="font-medium"><%= t('auto.k_4014616c302e') %></span>
                </a>
                <div class="pt-4 mt-4 border-t border-slate-200">
                    <a href="/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-red-50 text-red-600">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1"></path>
                        </svg>
                        <span class="font-medium"><%= t('auto.k_a8bdc00981e0') %></span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Mobile Sidebar -->
        <div id="mobileSidebar" class="md:hidden fixed inset-0 z-40 pointer-events-none">
            <div id="mobileSidebarOverlay" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>
            <div id="mobileSidebarPanel" class="absolute top-0 right-0 h-full w-72 bg-gradient-to-b from-slate-900 to-slate-800 text-white p-6 overflow-y-auto transform translate-x-full transition-transform duration-300">
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
                            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold"><%= t('auto.k_cae2a62bffd2') %></h2>
                            <p class="text-xs text-gray-300/80"><%= t('auto.k_07cafa008fd3') %></p>
                        </div>
                    </div>
                    <button id="mobileSidebarClose" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 transition-colors" aria-label="<%= t('auto.k_f6839701dc85') %>">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <nav class="space-y-2">
                    <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/10 <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'bg-white/10 border-r-4 border-accent' : '' %>" data-mobile-close>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                        <span class="font-medium"><%= t('auto.k_83cb78bbde58') %></span>
                    </a>
                    <a href="/admin/projects" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/10 <%= typeof currentPage !== 'undefined' && currentPage === 'projects' ? 'bg-white/10 border-r-4 border-accent' : '' %>" data-mobile-close>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7l9-4 9 4-9 4-9-4zm0 5l9 4 9-4m-18 5l9 4 9-4"></path></svg>
                        <span class="font-medium"><%= t('auto.k_b08b4dd634e4') %></span>
                    </a>
                    <a href="/admin/categories" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/10 <%= typeof currentPage !== 'undefined' && currentPage === 'categories' ? 'bg-white/10 border-r-4 border-accent' : '' %>" data-mobile-close>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 0 1 0 2.828l-7 7a2 2 0 0 1-2.828 0l-7-7A1.994 1.994 0 0 1 3 12V7a4 4 0 0 1 4-4z"></path>
                        </svg>
                        <span class="font-medium"><%= t('auto.k_fb6c30f397ae') %></span>
                    </a>
                    <a href="/admin/articles" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/10 <%= typeof currentPage !== 'undefined' && currentPage === 'articles' ? 'bg-white/10 border-r-4 border-accent' : '' %>" data-mobile-close>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span class="font-medium"><%= t('auto.k_d41e0bc0a701') %></span>
                    </a>
                    <a href="/admin/consultations" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/10 <%= typeof currentPage !== 'undefined' && currentPage === 'consultations' ? 'bg-white/10 border-r-4 border-accent' : '' %>" data-mobile-close>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <span class="font-medium"><%= t('auto.k_47aa49fbf0f1') %></span>
                    </a>
                <a href="/admin/subscribers" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/10 <%= typeof currentPage !== 'undefined' && currentPage === 'subscribers' ? 'bg-white/10 border-r-4 border-accent' : '' %>" data-mobile-close>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span class="font-medium"><%= t('auto.k_4014616c302e') %></span>
                </a>
                    <div class="pt-4 mt-4 border-t border-white/10">
                        <a href="/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-red-500/20 text-red-300" data-mobile-close>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1"></path>
                            </svg>
                            <span class="font-medium"><%= t('auto.k_a8bdc00981e0') %></span>
                        </a>
                    </div>
                </nav>
            </div>
        </div>

        <div class="flex-1 w-full md:pr-72">
            <!-- Mobile Header -->
            <header class="md:hidden flex items-center justify-between p-4 bg-white shadow-sm sticky top-0 z-30 border-b border-slate-200">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-base font-bold text-[#1E293B]"><%= t('auto.k_cae2a62bffd2') %></h1>
                        <p class="text-xs text-[#6B7280]"><%= t('auto.k_07cafa008fd3') %></p>
                    </div>
                </div>
                <button id="mobileSidebarToggle" class="p-2 rounded-xl bg-[#1E293B] text-white shadow-lg" aria-label="<%= t('auto.k_4fcd3460d598') %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                    </svg>
                </button>
            </header>

            <!-- Main Content -->
            <main class="p-4 md:p-6 lg:p-8 max-w-7xl mx-auto">
                <%- body %>
            </main>
        </div>
    </div>

    <script>
        (function () {
            const toggleButton = document.getElementById('mobileSidebarToggle');
            const closeButton = document.getElementById('mobileSidebarClose');
            const sidebar = document.getElementById('mobileSidebar');
            const overlay = document.getElementById('mobileSidebarOverlay');
            const panel = document.getElementById('mobileSidebarPanel');
            const closeTargets = document.querySelectorAll('[data-mobile-close]');

            if (!toggleButton || !sidebar || !overlay || !panel) return;

            const openSidebar = () => {
                sidebar.classList.remove('pointer-events-none');
                overlay.classList.remove('opacity-0');
                overlay.classList.add('opacity-100');
                panel.classList.remove('translate-x-full');
                document.body.classList.add('overflow-hidden');
            };

            const closeSidebar = () => {
                panel.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                overlay.classList.add('opacity-0');
                document.body.classList.remove('overflow-hidden');
                setTimeout(() => {
                    sidebar.classList.add('pointer-events-none');
                }, 300);
            };

            toggleButton.addEventListener('click', openSidebar);
            overlay.addEventListener('click', closeSidebar);
            closeTargets.forEach((el) => el.addEventListener('click', closeSidebar));
            if (closeButton) closeButton.addEventListener('click', closeSidebar);
        })();
    </script>
</body>
</html>
