<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex items-center justify-center p-4 bg-slate-50">
    <div class="w-full max-w-md">
        <!-- Logo -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center gap-3 mb-4">
                <div class="relative">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#2563EB] to-[#0D9488] flex items-center justify-center transform hover:scale-110 transition-transform duration-300 shadow-lg">
                        <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                        </svg>
                    </div>
                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-[#0D9488] rounded-full animate-ping"></div>
                </div>
            </div>
            <h1 class="text-3xl font-bold text-[#1E293B] mb-2">پنل مدیریت</h1>
            <p class="text-[#6B7280]">ورود به سیستم مدیریت</p>
        </div>

        <!-- Login Form -->
        <div class="card-modern !p-8 md:!p-10">
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-sm text-red-600 font-medium"><%= errorMessage %></p>
                    </div>
                </div>
            <% } %>
            <form action="/admin/login" method="POST" class="space-y-6">
                <div>
                    <label for="username" class="block text-[#1E293B] text-sm font-bold mb-2">
                        نام کاربری
                    </label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        required
                        autocomplete="username"
                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/20 transition-all duration-300 text-[#1E293B]"
                        placeholder="نام کاربری خود را وارد کنید"
                    >
                </div>
                <div>
                    <label for="password" class="block text-[#1E293B] text-sm font-bold mb-2">
                        رمز عبور
                    </label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        required
                        autocomplete="current-password"
                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/20 transition-all duration-300 text-[#1E293B]"
                        placeholder="رمز عبور خود را وارد کنید"
                    >
                </div>
                <button 
                    type="submit"
                    class="btn-primary w-full py-4"
                >
                    ورود به پنل
                </button>
            </form>

            <!-- Security Notice -->
            <div class="mt-6 pt-6 border-t border-gray-200">
                <div class="flex items-start gap-3 p-4 bg-[#F0F9FF] rounded-xl">
                    <svg class="w-5 h-5 text-[#2563EB] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                    <div>
                        <p class="text-xs text-[#6B7280] leading-relaxed">
                            این صفحه فقط برای مدیران سیستم است. در صورت فراموشی رمز عبور با مدیر سیستم تماس بگیرید.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-8">
            <p class="text-sm text-[#6B7280]">
                &copy; <%= new Date().getFullYear() %> شرکت تصفیه آب صبا. تمام حقوق محفوظ است.
            </p>
        </div>
    </div>
</body>
</html>
