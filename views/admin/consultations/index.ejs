<div class="mb-8">
    <% const totalRequests = consultations.reduce((sum, c) => sum + (c.requests ? c.requests.length : 0), 0); %>
    <% const handledRequestCount = consultations.reduce((sum, c) => sum + (c.requests ? c.requests.filter(r => r.contacted).length : 0), 0); %>
    <% const activeRequestCount = totalRequests - handledRequestCount; %>
    <div class="flex flex-col xl:flex-row justify-between items-start gap-4 mb-6">
        <div>
            <h1 class="text-4xl font-bold text-slate-900 mb-2">درخواست‌های مشاوره</h1>
            <p class="text-slate-500">مدیریت و پیگیری سریع درخواست‌های مشتریان</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a href="/admin/consultations" class="px-4 py-2 rounded-2xl border text-sm transition-all duration-200 <%= typeof currentView === 'undefined' || currentView !== 'handled' ? 'bg-[#2563EB] text-white border-[#2563EB]' : 'bg-white text-slate-600 border-slate-200' %>">درخواست‌های فعال</a>
            <a href="/admin/consultations?view=handled" class="px-4 py-2 rounded-2xl border text-sm transition-all duration-200 <%= typeof currentView !== 'undefined' && currentView === 'handled' ? 'bg-[#2563EB] text-white border-[#2563EB]' : 'bg-white text-slate-600 border-slate-200' %>">تماس‌های انجام‌شده</a>
            <a href="/admin/consultations?view=all" class="px-4 py-2 rounded-2xl border text-sm transition-all duration-200 <%= typeof currentView !== 'undefined' && currentView === 'all' ? 'bg-[#2563EB] text-white border-[#2563EB]' : 'bg-white text-slate-600 border-slate-200' %>">همه</a>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">کل درخواست‌ها</p>
            <p class="mt-3 text-3xl font-bold text-slate-900"><%= totalRequests %></p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">درخواست‌های فعال</p>
            <p class="mt-3 text-3xl font-bold text-slate-900"><%= activeRequestCount %></p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">تماس‌های انجام‌شده</p>
            <p class="mt-3 text-3xl font-bold text-slate-900"><%= handledRequestCount %></p>
        </div>
    </div>
</div>

<% if (consultations && consultations.length > 0) { %>
    <div class="space-y-6">
        <% consultations.forEach(consultation => { %>
                <div class="bg-white rounded-2xl p-6 shadow-xl border border-gray-100 hover:shadow-2xl transition-all duration-300">
                <div class="flex justify-between items-start mb-6">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#2563EB] to-[#0D9488] flex items-center justify-center">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-[#1E293B] mb-1"><%= consultation.name %></h3>
                            <div class="flex items-center gap-2 text-[#6B7280]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                                <span class="font-medium"><%= consultation.phone %></span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                            <span class="px-4 py-2 bg-primary text-white text-sm font-bold rounded-xl shadow-lg">
                                <%= consultation.requests.length %> درخواست
                            </span>
                            <% if (currentView !== 'handled') { %>
                                <form action="/admin/consultations/mark/<%= encodeURIComponent(consultation.phone) %>" method="POST" onsubmit="return confirm('آیا از علامت‌گذاری این گروه به عنوان "تماس گرفته شده" مطمئن هستید؟');">
                                    <button type="submit" class="px-3 py-2 bg-green-500 text-white rounded-lg text-sm">تماس برقرار شد</button>
                                </form>
                            <% } %>
                        </div>
                </div>

                <div class="bg-[#F0F9FF] rounded-xl p-4 mb-4">
                    <h4 class="font-bold text-[#1E293B] mb-4 flex items-center gap-2">
                        <svg class="w-5 h-5 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        جزئیات درخواست‌ها
                    </h4>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-white/50">
                                <tr>
                                    <th class="px-4 py-3 text-right text-xs font-bold text-[#2563EB] uppercase">محصول مورد نظر</th>
                                    <th class="px-4 py-3 text-right text-xs font-bold text-[#2563EB] uppercase">زمان تماس</th>
                                    <th class="px-4 py-3 text-right text-xs font-bold text-[#2563EB] uppercase">تاریخ ثبت</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-100">
                                <% consultation.requests.forEach(request => { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-3 text-sm text-[#1E293B]">
                                            <div class="space-y-1">
                                                <span class="px-3 py-1 bg-white rounded-lg text-xs font-medium block"><%= request.interestedInProduct || 'عمومی' %></span>
                                                <% if (request.projectType) { %>
                                                    <span class="px-2 py-1 bg-gray-100 rounded text-xs text-[#6B7280]"><%= request.projectType %></span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-[#6B7280]">
                                            <% 
                                                const timeLabels = {
                                                    'ASAP': 'در اسرع وقت',
                                                    'Morning': 'صبح (۹ تا ۱۲)',
                                                    'Afternoon': 'بعد از ظهر (۱۳ تا ۱۷)'
                                                };
                                            %>
                                            <span class="px-3 py-1 bg-[#F0F9FF] text-[#2563EB] rounded-lg text-xs font-medium">
                                                <%= timeLabels[request.contactTime] || request.contactTime %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-[#6B7280]">
                                            <%= new Date(request.submittedAt || request.date).toLocaleDateString('fa-IR', { 
                                                year: 'numeric', 
                                                month: 'long', 
                                                day: 'numeric',
                                                hour: '2-digit',
                                                minute: '2-digit'
                                            }) %>
                                            <% if (request.email) { %>
                                                <div class="text-xs text-[#2563EB] mt-1"><%= request.email %></div>
                                            <% } %>
                                            <% if (!request.contacted) { %>
                                                <div class="mt-2">
                                                    <form action="/admin/consultations/mark-id/<%= request.id %>" method="POST" onsubmit="return confirm('آیا از علامت‌گذاری این درخواست به عنوان "تماس گرفته شده" مطمئن هستید؟');">
                                                        <button type="submit" class="px-3 py-1 bg-green-500 text-white rounded-lg text-xs">تماس گرفتم</button>
                                                    </form>
                                                </div>
                                            <% } else { %>
                                                <div class="mt-2 text-xs text-green-700 font-medium">تماس گرفته شده</div>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
<% } else { %>
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100">
        <div class="text-center py-20">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#F0F9FF] mb-6">
                <svg class="w-10 h-10 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#1E293B] mb-4">درخواستی یافت نشد</h3>
            <p class="text-[#6B7280] mb-8">هنوز درخواست مشاوره‌ای ثبت نشده است.</p>
        </div>
    </div>
<% } %>
