<!-- Hero Section -->
<section class="relative min-h-[50vh] overflow-hidden pt-20 bg-gradient-to-br from-[var(--bg-milky)] via-white to-[var(--bg-milky)]">
  <div class="container mx-auto px-4 relative z-10 py-16">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full border border-[var(--primary)]/10 shadow-sm mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle w-4 h-4 text-[var(--accent)]">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        <span class="text-sm text-slate-500">ارتباط با ما</span>
      </div>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-slate-900 mb-6 leading-tight">
        تماس با ما
      </h1>
      <p class="text-xl text-slate-500 leading-relaxed">
        ما آماده پاسخگویی به سوالات و ارائه مشاوره رایگان به شما هستیم
      </p>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">اطلاعات تماس</h2>
          <p class="text-slate-500 mb-8">برای دریافت مشاوره رایگان، استعلام قیمت و بازدید از محل با ما تماس بگیرید</p>
        </div>

        <!-- Phone -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-[var(--primary)] to-[var(--accent)] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone w-7 h-7 text-white">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold">تلفن تماس</h3>
              <a href="tel:09122515229" class="block text-primary hover:text-[var(--accent)] transition-colors mb-1 dir-ltr text-right font-semibold text-lg">0912-251-5229</a>
              <a href="tel:09384092125" class="block text-primary hover:text-[var(--accent)] transition-colors mb-1 dir-ltr text-right font-semibold text-lg">0938-409-2125</a>
              <a href="tel:02536550672" class="block text-primary hover:text-[var(--accent)] transition-colors dir-ltr text-right font-semibold text-lg">025-36550672</a>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-[var(--accent)] to-[var(--primary)] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail w-7 h-7 text-white">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold">ایمیل</h3>
              <a href="mailto:info@sabatasfiyeh.com" class="block text-primary hover:text-[var(--accent)] transition-colors mb-1 font-semibold">info@sabatasfiyeh.com</a>
              <a href="mailto:support@sabatasfiyeh.com" class="block text-primary hover:text-[var(--accent)] transition-colors font-semibold">support@sabatasfiyeh.com</a>
            </div>
          </div>
        </div>

        <!-- Address -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-[var(--cta)] to-[var(--primary)] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-7 h-7 text-white">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold">آدرس دفتر مرکزی</h3>
              <p class="text-slate-500 leading-relaxed">
                قم، بلوار کوه سفید، کوچه ۲۲، پلاک ۵
              </p>
            </div>
          </div>
        </div>

        <!-- Working Hours -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-[var(--primary)] to-[var(--cta)] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-7 h-7 text-white">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold">ساعات کاری</h3>
              <p class="text-slate-500 mb-1">شنبه تا پنج‌شنبه: ۸:۰۰ - ۱۸:۰۰</p>
              <p class="text-slate-500">پشتیبانی 24 ساعته برای مشتریان صنعتی</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Map and Consultation Form -->
      <div class="space-y-8">
        <!-- Map -->
        <div class="card-modern !p-0 overflow-hidden">
          <div class="p-6 border-b border-gray-100">
            <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin text-primary">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              نقشه موقعیت
            </h3>
          </div>
          <div class="h-96 bg-slate-100 flex items-center justify-center p-6 text-center rounded-b-3xl">
            <div>
              <p class="text-xl font-bold text-slate-900 mb-2">محل کار مرکزی</p>
              <p class="text-slate-500">قم، بلوار کوه سفید، کوچه ۲۲، پلاک ۵</p>
              <p class="text-slate-500 mt-3">لطفاً برای راهنمایی سریع‌تر با شماره‌های پشتیبانی تماس بگیرید.</p>
            </div>
          </div>
        </div>

        <!-- Consultation Form -->
        <div class="card-modern !p-0 overflow-hidden">
          <div class="p-8 md:p-10">
            <div class="mb-8">
              <h3 class="text-2xl text-slate-900 mb-2 font-bold">فرم درخواست تماس</h3>
              <p class="text-slate-500">
                فرم زیر را تکمیل کنید تا کارشناسان ما در اسرع وقت با شما تماس بگیرند
              </p>
            </div>
            <form action="/consultation" method="POST" class="space-y-6" id="contactForm">
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block mb-2 text-slate-900 font-semibold">نام و نام خانوادگی *</label>
                  <input name="name" required
                    class="input-field h-12"
                    placeholder="نام کامل خود را وارد کنید" />
                </div>
                <div>
                  <label class="block mb-2 text-slate-900 font-semibold">شماره تماس *</label>
                  <input name="phone" required
                    class="input-field h-12 dir-ltr text-right"
                    placeholder="۰۹۱۲-۳۴۵-۶۷۸۹" />
                </div>
              </div>
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block mb-2 text-slate-900 font-semibold">ایمیل</label>
                  <input type="email" name="email"
                    class="input-field h-12"
                    placeholder="example@company.com" />
                </div>
                <div>
                  <label class="block mb-2 text-slate-900 font-semibold">نوع پروژه</label>
                  <select name="projectType"
                    class="w-full h-12 px-4 rounded-xl border-2 border-[var(--primary)]/20 focus:border-[var(--primary)] focus:outline-none bg-white text-slate-900">
                    <option>خانگی</option>
                    <option>صنعتی کوچک</option>
                    <option>صنعتی بزرگ</option>
                    <option>تجاری</option>
                  </select>
                </div>
              </div>
              <div>
                <label class="block mb-2 text-slate-900 font-semibold">پیام شما</label>
                <textarea name="message"
                  class="w-full px-4 py-3 rounded-xl border-2 border-[var(--primary)]/20 focus:border-[var(--primary)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 transition-all duration-300 text-slate-900 min-h-[140px] resize-none"
                  placeholder="توضیحات و نیاز خود را بنویسید..."></textarea>
              </div>
              <input type="hidden" name="contactTime" value="هر زمان" />
              <div class="flex gap-4">
                <button type="submit"
                  class="btn-cta flex-1 flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-send w-5 h-5 group-hover:translate-x-1 transition-transform">
                    <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
                    <path d="m21.854 2.147-10.94 10.939"></path>
                  </svg>
                  ارسال درخواست
                </button>

                <a href="tel:09122515229"
                  class="btn-cta flex-1 flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-phone w-5 h-5">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                  تماس فوری
                </a>
              </div>
              <p class="text-xs text-slate-500 text-center">
                با ارسال فرم، شما با قوانین و مقررات ما موافقت می‌کنید
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
