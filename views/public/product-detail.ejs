<% if (product) { %>
<%
    const noteOf = p => [p.material, p.dimensions].filter(Boolean).join(' · ');
%>

<section class="section section--tone-bone" style="padding-top:clamp(6rem,12vw,9rem)">
    <div class="container">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-3 text-sm mb-10" style="color:var(--color-stone-ink)" data-reveal>
            <a href="/<%= locale %>/" class="hover:text-brass transition-colors inline-block py-2"><%= t('atelier.home') %></a>
            <span>/</span>
            <a href="/<%= locale %>/products" class="hover:text-brass transition-colors inline-block py-2"><%= t('nav.products') %></a>
            <span>/</span>
            <% if (product.categorySlug) { %>
            <a href="/<%= locale %>/category/<%= encodeURIComponent(product.categorySlug) %>" class="hover:text-brass transition-colors inline-block py-2"><%= product.category %></a>
            <span>/</span>
            <% } %>
            <span class="text-ink"><%= product.name %></span>
        </nav>

        <div class="pdetail">
            <!-- Gallery -->
            <div class="pdetail__media" data-gallery>
                <div class="pdetail__main" data-reveal>
                    <img src="<%= img(product.mainImage || '/icons/naghshe-ara-logo.png', 1024) %>"<%- responsive(product.mainImage || '/icons/naghshe-ara-logo.png', [640, 1024, 1280], '(min-width: 1024px) 50vw, 100vw') %> alt="<%= product.patternName || product.name %> — <%= [product.color, product.material].filter(Boolean).join('، ') || t('atelier.brandTag') %>" width="1000" height="1000" data-gallery-main fetchpriority="high" decoding="async">
                </div>
                <% if (product.galleryImages && product.galleryImages.length > 0) { %>
                    <div class="pdetail__thumbs" data-reveal style="--reveal-delay:100ms">
                        <button type="button" class="pdetail__thumb is-active" data-gallery-thumb="<%= img(product.mainImage, 1024) %>">
                        <img src="<%= img(product.mainImage, 160) %>" alt="<%= product.patternName || product.name %>" width="96" height="96" loading="lazy" decoding="async">
                        </button>
                        <% product.galleryImages.forEach(image => { %>
                            <button type="button" class="pdetail__thumb" data-gallery-thumb="<%= img(image, 1024) %>">
                            <img src="<%= img(image, 160) %>" alt="<%= product.patternName || product.name %>" width="96" height="96" loading="lazy" decoding="async">
                            </button>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Sticky spec panel -->
            <div class="pdetail__info">
                <div data-reveal>
                    <span class="eyebrow mb-6"><%= product.category || t('atelier.fromCollection') %></span>
                    <h1 class="pdetail__title"><%= product.name %></h1>
                    <p class="pdetail__sub">
                        <% const sub = [product.color, product.material].filter(Boolean).join(' — '); %>
                        <%= sub || product.name %>
                    </p>
                </div>

                <div data-reveal style="--reveal-delay:100ms">
                    <% if (product.description && product.description.trim()) { %>
                        <p class="pdetail__lead"><%= product.description %></p>
                    <% } %>
                </div>

                <dl class="spec" data-reveal style="--reveal-delay:160ms">
                    <% if (product.patternName) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.patternName') %></dt>
                            <dd class="spec__val"><%= product.patternName %></dd>
                        </div>
                    <% } %>
                    <% if (product.color) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.color') %></dt>
                            <dd class="spec__val"><%= product.color %></dd>
                        </div>
                    <% } %>
                    <% if (product.material) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.material') %></dt>
                            <dd class="spec__val"><%= product.material %></dd>
                        </div>
                    <% } %>
                    <% if (product.dimensions) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.dimensions') %></dt>
                            <dd class="spec__val"><%= product.dimensions %></dd>
                        </div>
                    <% } %>
                    <% if (product.usageArea && product.usageArea.length) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.usageArea') %></dt>
                            <dd class="spec__val">
                                <span class="tag-row justify-end">
                                    <% product.usageArea.forEach(area => { %><span class="tag"><%= area %></span><% }); %>
                                </span>
                            </dd>
                        </div>
                    <% } %>
                    <% const builtIn = new Set([t('atelier.patternName'), t('atelier.color'), t('atelier.material'), t('atelier.dimensions'), t('atelier.usageArea')]); %>
                    <% if (product.specs && typeof product.specs === 'object' && Object.keys(product.specs).length) { %>
                        <% Object.entries(product.specs).filter(([key]) => !builtIn.has(String(key).trim())).forEach(([key, value]) => { %>
                            <div class="spec__row">
                                <dt class="spec__key"><%= key %></dt>
                                <dd class="spec__val"><%= value %></dd>
                            </div>
                        <% }); %>
                    <% } %>
                </dl>

                <div class="flex flex-col sm:flex-row gap-3 pt-8" data-reveal style="--reveal-delay:220ms">
                    <a href="/<%= locale %>/consultation?product=<%= encodeURIComponent(product.name) %>" class="btn btn-brass flex-1">
                        <%= t('atelier.requestConsultation') %>
                    </a>
                    <a href="/<%= locale %>/products" class="btn btn-outline flex-1">
                        <%= t('atelier.backToPatterns') %>
                    </a>
                </div>
                <% if (product.tileCutout) { %>
                <a href="/<%= locale %>/visualizer?product=<%= encodeURIComponent(product.slug) %>" class="btn btn-outline w-full mt-3" style="border-color:var(--color-brass);color:var(--color-jade)">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
                    <%= t('atelier.vizOnProduct') %>
                </a>
                <% } %>

                <div class="grid grid-cols-2 gap-x-8 gap-y-4 pt-10" data-reveal style="--reveal-delay:280ms">
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_15e1c23fe67a') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone-ink)"><%= t('auto.k_6479eed024ea') %></div>
                    </div>
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_438ef1007502') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone-ink)"><%= t('auto.k_3d871fc609bf') %></div>
                    </div>
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_db80b9884a5e') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone-ink)"><%= t('auto.k_9c428cc9b156') %></div>
                    </div>
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_41bd65830b61') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone-ink)"><%= product.manufacturer || t('atelier.brandName') %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<% if (usedInProjects && usedInProjects.length) { %>
<section class="section section--tone-bone">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.casesEyebrow') %></span>
            <h2 class="section__title"><%= t('atelier.usedInProjects') %></h2>
        </div>
        <div class="editorial-grid">
            <% usedInProjects.forEach((pj, i) => { const cover = pj.coverImage || (pj.galleryImages && pj.galleryImages[0]) || '/icons/naghshe-ara-logo.png'; %>
                <a href="/<%= locale %>/project/<%= encodeURIComponent(pj.slug) %>"
                    class="ed-card <%= i === 0 ? 'ed-card--big' : 'ed-card--small' %> group" data-reveal style="--reveal-delay:<%= i * 80 %>ms">
                    <div class="ed-card__media">
                        <img src="<%= img(cover, 480) %>"<%- responsive(cover, [320, 480, 640], '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw') %> alt="<%= [pj.title, pj.location].filter(Boolean).join(' — ') %>" width="800" height="800" loading="lazy" decoding="async">
                    </div>
                    <div class="ed-card__body">
                        <% if (pj.location) { %><div class="ed-card__cat"><%= pj.location %></div><% } %>
                        <h3 class="ed-card__name"><%= pj.title %></h3>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<% if (relatedProducts && relatedProducts.length) { %>
<section class="section section--tone-ivory hairline-y">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.related') %></span>
            <h2 class="section__title"><%= t('atelier.related') %></h2>
        </div>
        <div class="editorial-grid">
            <% relatedProducts.forEach((rp, i) => { %>
                <a href="/<%= locale %>/product/<%= encodeURIComponent(rp.slug) %>"
                    class="ed-card <%= i === 0 ? 'ed-card--big' : 'ed-card--small' %> group" data-reveal style="--reveal-delay:<%= i * 80 %>ms">
                    <div class="ed-card__media">
                        <img src="<%= img(rp.mainImage || '/icons/naghshe-ara-logo.png', 480) %>"<%- responsive(rp.mainImage || '/icons/naghshe-ara-logo.png', [320, 480, 640], '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw') %> alt="<%= rp.patternName || rp.name %>" width="800" height="800" loading="lazy" decoding="async">
                    </div>
                    <div class="ed-card__body">
                        <% if (rp.category) { %><div class="ed-card__cat"><%= rp.category %></div><% } %>
                        <h3 class="ed-card__name"><%= rp.patternName || rp.name %></h3>
                        <p class="ed-card__note"><%= noteOf(rp) %></p>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<%- include('_buy-guide', { compact: true }) %>

<% } else { %>
<section class="section section--tone-bone text-center" style="padding-top:12rem;padding-bottom:12rem">
    <h1 class="text-3xl font-bold mb-4"><%= t('auto.k_fd2028ee66ca') %></h1>
    <p class="mb-8" style="color:var(--color-stone-ink)"><%= t('auto.k_da0fa8186da7') %></p>
    <a href="/<%= locale %>/products" class="btn btn-brass"><%= t('atelier.allPatterns') %></a>
</section>
<% } %>
