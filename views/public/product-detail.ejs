<% if (product) { %>
<%
    const productImages = [product.mainImage, ...(product.galleryImages || [])]
        .filter(Boolean)
        .map(image => image.startsWith('http') ? image : siteUrl + image);
    const productStructuredData = {
        '@context': 'https://schema.org',
        '@type': 'Product',
        '@id': siteUrl + '/' + locale + '/product/' + encodeURIComponent(product.slug) + '#product',
        name: product.name,
        image: productImages,
        description: product.metaDescription || product.description || undefined,
        category: product.category || undefined,
        brand: { '@type': 'Brand', name: 'نقش آرا' },
        url: siteUrl + '/' + locale + '/product/' + encodeURIComponent(product.slug)
    };
    const noteOf = p => [p.material, p.dimensions].filter(Boolean).join(' · ');
%>
<script type="application/ld+json"><%- JSON.stringify(productStructuredData).replace(/</g, '\\u003c') %></script>

<section class="section section--tone-bone" style="padding-top:clamp(6rem,12vw,9rem)">
    <div class="container">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-3 text-sm mb-10" style="color:var(--color-stone)" data-reveal>
            <a href="/<%= locale %>/" class="hover:text-brass transition-colors"><%= t('atelier.home') %></a>
            <span>/</span>
            <a href="/<%= locale %>/products" class="hover:text-brass transition-colors"><%= t('nav.products') %></a>
            <span>/</span>
            <span class="text-ink"><%= product.patternName || product.name %></span>
        </nav>

        <div class="pdetail">
            <!-- Gallery -->
            <div class="pdetail__media">
                <div class="pdetail__main" data-reveal>
                    <img src="<%= product.mainImage || '/icons/naghshe-ara-logo.png' %>" alt="<%= product.patternName || product.name %>" id="mainImage" fetchpriority="high" decoding="async">
                </div>
                <% if (product.galleryImages && product.galleryImages.length > 0) { %>
                    <div class="pdetail__thumbs" data-reveal style="--reveal-delay:100ms">
                        <button type="button" class="pdetail__thumb is-active" onclick="changeMainImage('<%= product.mainImage %>')">
                        <img src="<%= product.mainImage %>" alt="<%= product.patternName || product.name %>">
                        </button>
                        <% product.galleryImages.forEach(img => { %>
                            <button type="button" class="pdetail__thumb" onclick="changeMainImage('<%= img %>')">
                            <img src="<%= img %>" alt="<%= product.patternName || product.name %>">
                            </button>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Sticky spec panel -->
            <div class="pdetail__info">
                <div data-reveal>
                    <span class="eyebrow mb-6"><%= product.category || t('atelier.fromCollection') %></span>
                    <h1 class="pdetail__title"><%= product.patternName || product.name %></h1>
                    <p class="pdetail__sub">
                        <% const sub = [product.color, product.material].filter(Boolean).join(' — '); %>
                        <%= sub || product.name %>
                    </p>
                </div>

                <div data-reveal style="--reveal-delay:100ms">
                    <% if (product.description && product.description.trim()) { %>
                        <p class="pdetail__lead"><%= product.description %></p>
                    <% } %>
                </div>

                <dl class="spec" data-reveal style="--reveal-delay:160ms">
                    <% if (product.patternName) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.patternName') %></dt>
                            <dd class="spec__val"><%= product.patternName %></dd>
                        </div>
                    <% } %>
                    <% if (product.color) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.color') %></dt>
                            <dd class="spec__val"><%= product.color %></dd>
                        </div>
                    <% } %>
                    <% if (product.material) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.material') %></dt>
                            <dd class="spec__val"><%= product.material %></dd>
                        </div>
                    <% } %>
                    <% if (product.dimensions) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.dimensions') %></dt>
                            <dd class="spec__val"><%= product.dimensions %></dd>
                        </div>
                    <% } %>
                    <% if (product.usageArea && product.usageArea.length) { %>
                        <div class="spec__row">
                            <dt class="spec__key"><%= t('atelier.usageArea') %></dt>
                            <dd class="spec__val">
                                <span class="tag-row justify-end">
                                    <% product.usageArea.forEach(area => { %><span class="tag"><%= area %></span><% }); %>
                                </span>
                            </dd>
                        </div>
                    <% } %>
                    <% if (product.specs && typeof product.specs === 'object' && Object.keys(product.specs).length) { %>
                        <% Object.entries(product.specs).forEach(([key, value]) => { %>
                            <div class="spec__row">
                                <dt class="spec__key"><%= key %></dt>
                                <dd class="spec__val"><%= value %></dd>
                            </div>
                        <% }); %>
                    <% } %>
                </dl>

                <div class="flex flex-col sm:flex-row gap-3 pt-8" data-reveal style="--reveal-delay:220ms">
                    <a href="/<%= locale %>/consultation?product=<%= encodeURIComponent(product.name) %>" class="btn btn-brass flex-1">
                        <%= t('atelier.requestConsultation') %>
                    </a>
                    <a href="/<%= locale %>/products" class="btn btn-outline flex-1">
                        <%= t('atelier.backToPatterns') %>
                    </a>
                </div>

                <div class="grid grid-cols-2 gap-x-8 gap-y-4 pt-10" data-reveal style="--reveal-delay:280ms">
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_15e1c23fe67a') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone)"><%= t('auto.k_6479eed024ea') %></div>
                    </div>
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_438ef1007502') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone)"><%= t('auto.k_3d871fc609bf') %></div>
                    </div>
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_db80b9884a5e') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone)"><%= t('auto.k_9c428cc9b156') %></div>
                    </div>
                    <div class="hairline-t pt-4">
                        <div class="font-semibold text-sm"><%= t('auto.k_41bd65830b61') %></div>
                        <div class="text-xs mt-1" style="color:var(--color-stone)"><%= product.manufacturer || t('atelier.brandName') %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<% if (relatedProducts && relatedProducts.length) { %>
<section class="section section--tone-ivory hairline-y">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.related') %></span>
            <h2 class="section__title"><%= t('atelier.related') %></h2>
        </div>
        <div class="editorial-grid">
            <% relatedProducts.forEach((rp, i) => { %>
                <a href="/<%= locale %>/product/<%= encodeURIComponent(rp.slug) %>"
                    class="ed-card <%= i === 0 ? 'ed-card--big' : 'ed-card--small' %> group" data-reveal style="--reveal-delay:<%= i * 80 %>ms">
                    <div class="ed-card__media">
                        <img src="<%= rp.mainImage || '/icons/naghshe-ara-logo.png' %>" alt="<%= rp.patternName || rp.name %>" loading="lazy" decoding="async">
                    </div>
                    <div class="ed-card__body">
                        <% if (rp.category) { %><div class="ed-card__cat"><%= rp.category %></div><% } %>
                        <h3 class="ed-card__name"><%= rp.patternName || rp.name %></h3>
                        <p class="ed-card__note"><%= noteOf(rp) %></p>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<script>
    function changeMainImage(src) {
        var main = document.getElementById('mainImage');
        main.style.opacity = '0';
        setTimeout(function () {
            main.src = src;
            main.onload = function () { main.style.opacity = '1'; };
        }, 180);
        var thumbs = document.querySelectorAll('.pdetail__thumb');
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        var active = Array.prototype.find.call(thumbs, function (t) {
            var s = t.querySelector('img') ? t.querySelector('img').getAttribute('src') : '';
            return s === src || src.indexOf(s) >= 0 || s.indexOf(src) >= 0;
        });
        if (active) active.classList.add('is-active');
    }
</script>
<% } else { %>
<section class="section section--tone-bone text-center" style="padding-top:12rem;padding-bottom:12rem">
    <h1 class="text-3xl font-bold mb-4"><%= t('auto.k_fd2028ee66ca') %></h1>
    <p class="mb-8" style="color:var(--color-stone)"><%= t('auto.k_da0fa8186da7') %></p>
    <a href="/<%= locale %>/products" class="btn btn-brass"><%= t('atelier.allPatterns') %></a>
</section>
<% } %>
