<section class="section section--tone-bone" style="padding-top:clamp(6rem,12vw,9rem)">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.casesEyebrow') %></span>
            <h1 class="section__title"><%= t('auto.k_e2dd64a638a6') %></h1>
            <p class="section__lead"><%= t('auto.k_7ff49a5092af') %></p>
        </div>

        <% if (projects && projects.length) { %>
            <div class="space-y-20 lg:space-y-32 lg:py-6">
                <% projects.forEach((project, i) => { %>
                    <a href="/<%= locale %>/project/<%= encodeURIComponent(project.slug) %>"
                        class="case <%= i % 2 === 1 ? 'case--reverse' : '' %> group" data-reveal>
                        <div class="case__media">
                            <% const coverImg = project.coverImage || (project.galleryImages && project.galleryImages[0]) || '/placeholder.jpg'; %>
                            <img width="1200" height="900" loading="lazy" decoding="async" src="<%= img(coverImg, 1024) %>"<%- responsive(coverImg, [640, 1024, 1280], '(min-width: 1024px) 50vw, 100vw') %>
                                alt="<%= project.title %>">
                        </div>
                        <div class="case__body">
                            <div class="case__num">0<%= i + 1 %></div>
                            <% if (project.location) { %><div class="case__location"><%= project.location %></div><% } %>
                            <h2 class="case__title"><%= project.title %></h2>
                            <% if (project.description) { %><p class="case__desc"><%= project.description %></p><% } %>
                            <span class="case__link"><%= t('atelier.viewCase') %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </span>
                        </div>
                    </a>
                <% }); %>
            </div>
        <% } else { %>
            <div class="py-24 text-center">
                <h2 class="text-2xl font-bold mb-6"><%= t('auto.k_fa992b481d53') %></h2>
                <a href="/<%= locale %>/" class="btn btn-brass"><%= t('atelier.backHome') %></a>
            </div>
        <% } %>
    </div>
</section>