<section class="section section--tone-bone page-top">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('auto.k_a9b836f40107') %></span>
            <h1 class="section__title"><%= t('auto.k_7234f13f7714') %></h1>
            <p class="section__lead"><%= t('auto.k_9f90a5b73031') %></p>
        </div>
        <% if (articles && articles.length > 0) { %>
        <div class="article-grid">
            <% articles.forEach((a, i) => { %><%- include('_article-card', { a, i }) %><% }); %>
        </div>
        <% } else { %>
        <div class="py-20 text-center">
            <h2 class="text-2xl font-bold mb-3"><%= t('auto.k_a6de383aa0f9') %></h2>
            <p style="color:var(--color-stone-ink)"><%= t('auto.k_ea926b312160') %></p>
        </div>
        <% } %>
    </div>
</section>
