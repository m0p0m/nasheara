<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% Object.entries(alternateUrls).forEach(([language, url]) => { %>
    <link rel="alternate" hreflang="<%= language %>" href="<%= url %>">
    <% }); %>
    <title><%= typeof title !== 'undefined' ? title : t('seo.homeTitle') %></title>
    <meta name="description"
        content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('auto.k_6ee1d3a1f6a2') %>">
    <meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' %>">
    <meta name="keywords"
        content="<%= typeof metaKeywords !== 'undefined' ? metaKeywords : t('auto.k_c518bfdfd1b4') %>">
    <meta name="author" content="<%= t('auto.k_e6736350dccf') %>">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : t('auto.k_9bb88d484369') %>">
    <meta property="og:description"
        content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('auto.k_3f56b4ab4645') %>">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
    <meta property="og:url"
        content="<%= canonicalUrl %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : siteUrl + '/icons/logo-1024.png' %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= typeof title !== 'undefined' ? title : t('auto.k_d26f50636237') %>">
    <meta property="og:locale" content="<%= locale === 'fa' ? 'fa_IR' : (locale === 'en' ? 'en_US' : 'ar_SA') %>">
    <% ['fa', 'en', 'ar'].filter(l => l !== locale).forEach(l => { %>
    <meta property="og:locale:alternate" content="<%= l === 'fa' ? 'fa_IR' : (l === 'en' ? 'en_US' : 'ar_SA') %>">
    <% }); %>
    <meta property="og:site_name" content="<%= t('atelier.brandName') %>">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : t('auto.k_9bb88d484369') %>">
    <meta name="twitter:description"
        content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('auto.k_d94f40d44584') %>">
    <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : siteUrl + '/icons/logo-1024.png' %>">

    <link rel="canonical" href="<%= canonicalUrl %>">

    <!-- Favicon and Logo -->
    <link rel="icon" href="/icons/favicon-64.png" sizes="64x64" type="image/png">
    <link rel="icon" href="/icons/favicon-192.png" sizes="192x192" type="image/png">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">

    <!-- Fonts: fa/ar use self-hosted Vazirmatn; en uses Fraunces (display) + Inter (body) -->
    <% if (locale !== 'en') { %><link rel="preload" href="/fonts/vazirmatn/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/vazirmatn/Vazirmatn-Bold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/naskh/NotoNaskhArabic-wght.woff2" as="font" type="font/woff2" crossorigin><% } %>
    <% if (currentPath === '/') { %><link rel="preload" href="<%= img('/icons/1.png', 1600) %>" as="image" imagesrcset="<%= srcset('/icons/1.png', [800, 1280, 1600, 2048]) %>" imagesizes="100vw" fetchpriority="high"><% } %>
    <% if (locale === 'en') { %><link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Loaded without blocking first paint: applied by site.js once parsed (font-display: swap covers the gap). -->
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" media="print" data-defer-style><% } %>

    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": ["Organization", "LocalBusiness"],
        "name": "<%= t('atelier.brandName') %>",
        "alternateName": "<%= t('atelier.brandTag') %>",
        "url": "<%= siteUrl %>",
        "logo": {
            "@type": "ImageObject",
            "url": "<%= siteUrl %>/icons/logo-1024.png",
            "width": 1252,
            "height": 1151
        },
        "description": "<%= t('auto.k_1a135a699aa6') %>",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "قم، خیابان جمهوری، نبش کوچه ۵۰",
            "addressLocality": "قم",
            "addressRegion": "قم",
            "postalCode": "37158",
            "addressCountry": "IR"
        },
        "contactPoint": [
            {
                "@type": "ContactPoint",
                "telephone": "+98-912-451-9443",
                "contactType": "customer service",
                "areaServed": "IR",
                "availableLanguage": ["Persian"]
            }
        ],
        "openingHoursSpecification": [
            {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                    "Saturday",
                    "Sunday",
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday"
                ],
                "opens": "08:00",
                "closes": "18:00"
            }
        ],
        "priceRange": "$$",
        "sameAs": [
            "https://www.instagram.com/nashearatasfiyeh",
            "https://t.me/nashearatasfiyeh"
        ],
        "areaServed": [
            { "@type": "Country", "name": "Iran" },
            <%- ['Qom', 'Tehran', 'Karaj', 'Isfahan', 'Kashan', 'Mashhad', 'Shiraz', 'Tabriz', 'Yazd', 'Ahvaz', 'Rasht', 'Kerman', 'Hamadan', 'Urmia', 'Qazvin', 'Sari', 'Arak', 'Kermanshah', 'Bandar Abbas', 'Zanjan']
                .map(city => `{ "@type": "City", "name": "${city}" }`).join(',\n            ') %>
        ],
        "knowsAbout": [
            "<%= t('auto.k_e793d09fd794') %>",
            "<%= t('auto.k_a2e513b6d526') %>",
            "<%= t('auto.k_4e4b7698700b') %>",
            "<%= t('auto.k_098f35f33ee7') %>",
            "<%= t('auto.k_f456fa7cb896') %>"
        ],
        "makesOffer": [
            { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "<%= t('auto.k_7fae9146da8f') %>" } },
            { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "<%= t('auto.k_819ba7cf5733') %>" } },
            { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "<%= t('auto.k_4b4ff2dcc670') %>" } }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "<%= t('atelier.brandName') %>",
        "url": "<%= siteUrl %>",
        "inLanguage": ["fa-IR", "en", "ar"]
    }
    </script>

    <% if (typeof structuredData !== 'undefined' && Array.isArray(structuredData)) { structuredData.forEach(item => { %>
    <script type="application/ld+json"><%- JSON.stringify(item).replace(/</g, '\u003c') %></script>
    <% }); } %>

    <link rel="stylesheet" href="<%= asset('/css/style.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/responsive.css') %>">
</head>

<body class="min-h-screen <%= locale === 'en' ? 'font-en' : 'font-fa-ar' %>" dir="<%= dir %>">
    <!-- Header -->
    <header class="site-header<%= currentPath === '/' ? ' site-header--overlay' : '' %>" id="siteHeader">
        <div class="container">
            <div class="site-header__inner">
                <a href="/<%= locale %>/" class="site-brand" aria-label="<%= t('atelier.brandName') %>">
                    <img class="site-brand__logo" src="<%= img('/icons/naghshe-ara-logo.png', 160) %>"<%- responsive('/icons/naghshe-ara-logo.png', [160, 320], '80px') %> alt="<%= t('atelier.brandName') %>" width="1252" height="1151" decoding="async">
                </a>

                <nav class="site-nav hidden lg:flex" aria-label="<%= t('nav.home') %>">
                    <a href="/<%= locale %>/" class="site-nav__link <%= currentPath === '/' ? 'is-active' : '' %>"><%= t('nav.home') %></a>
                    <a href="/<%= locale %>/products" class="site-nav__link <%= currentPath && currentPath.startsWith('/products') ? 'is-active' : '' %>"><%= t('nav.products') %></a>
                    <a href="/<%= locale %>/projects" class="site-nav__link <%= currentPath && currentPath.startsWith('/projects') ? 'is-active' : '' %>"><%= t('nav.projects') %></a>
                    <a href="/<%= locale %>/articles" class="site-nav__link <%= currentPath && currentPath.startsWith('/articles') ? 'is-active' : '' %>"><%= t('nav.articles') %></a>
                    <a href="/<%= locale %>/contact" class="site-nav__link <%= currentPath && currentPath.startsWith('/contact') ? 'is-active' : '' %>"><%= t('nav.contact') %></a>
                    <a href="/<%= locale %>/visualizer" class="site-nav__link site-nav__link--tool <%= currentPath && currentPath.startsWith('/visualizer') ? 'is-active' : '' %>">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
                        <%= t('nav.visualizer') %>
                    </a>
                </nav>

                <div class="flex items-center gap-4">
                    <div class="site-lang site-lang--mobile md:hidden" aria-label="<%= t('language.switch') %>">
                        <% ['fa', 'en', 'ar'].forEach(lang => { %>
                            <a href="<%= alternateUrls[lang] %>" lang="<%= lang %>" class="<%= locale === lang ? 'is-current' : '' %>"><%= lang.toUpperCase() %></a>
                        <% }); %>
                    </div>
                    <div class="site-lang hidden md:inline-flex" aria-label="<%= t('language.switch') %>">
                        <% ['fa', 'en', 'ar'].forEach(lang => { %>
                            <a href="<%= alternateUrls[lang] %>" lang="<%= lang %>" class="<%= locale === lang ? 'is-current' : '' %>"><%= lang.toUpperCase() %></a>
                        <% }); %>
                    </div>
                    <a href="/<%= locale %>/consultation" class="btn btn-solid btn--sm hidden md:inline-flex">
                        <%= t('atelier.consultCta') %>
                    </a>
                    <button class="site-burger lg:hidden" id="mobileMenuBtn" aria-label="<%= t('auto.k_4fcd3460d598') %>" aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile menu -->
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
        <div class="mobile-menu__backdrop" id="mobileMenuBackdrop"></div>
        <div class="mobile-menu__panel">
            <button class="mobile-menu__close" id="closeMobileMenu" aria-label="<%= t('auto.k_f6839701dc85') %>">&times;</button>
            <a href="/<%= locale %>/" class="site-brand mb-8" aria-label="<%= t('atelier.brandName') %>">
                <img class="site-brand__logo" src="<%= img('/icons/naghshe-ara-logo.png', 160) %>"<%- responsive('/icons/naghshe-ara-logo.png', [160, 320], '80px') %> alt="<%= t('atelier.brandName') %>" width="1252" height="1151" decoding="async">
            </a>
            <nav class="flex flex-col" aria-label="<%= t('nav.home') %>">
                <a href="/<%= locale %>/" class="mobile-menu__link"><%= t('nav.home') %></a>
                <a href="/<%= locale %>/products" class="mobile-menu__link"><%= t('nav.products') %></a>
                <a href="/<%= locale %>/projects" class="mobile-menu__link"><%= t('nav.projects') %></a>
                <a href="/<%= locale %>/articles" class="mobile-menu__link"><%= t('nav.articles') %></a>
                <a href="/<%= locale %>/contact" class="mobile-menu__link"><%= t('nav.contact') %></a>
                <a href="/<%= locale %>/visualizer" class="mobile-menu__link"><%= t('nav.visualizer') %></a>
            </nav>
            <div class="mt-8 space-y-6">
                <div class="site-lang" aria-label="<%= t('language.switch') %>">
                    <% ['fa', 'en', 'ar'].forEach(lang => { %>
                        <a href="<%= alternateUrls[lang] %>" lang="<%= lang %>" class="<%= locale === lang ? 'is-current' : '' %>"><%= lang.toUpperCase() %></a>
                    <% }); %>
                </div>
                <a href="/<%= locale %>/consultation" class="btn btn-solid w-full"><%= t('atelier.consultCta') %></a>
                <div class="hairline-t pt-5">
                    <a href="tel:+989124519443" class="ltr-text block font-semibold text-lg">+98 912 451 9443</a>
                    <span class="text-sm" style="color:var(--color-stone-ink)"><%= t('atelier.phoneSupport') %></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="<%= currentPath === '/' ? '' : 'pt-[84px]' %>">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__bar">
                <div class="site-footer__brand">
                    <a href="/<%= locale %>/" class="site-brand" aria-label="<%= t('atelier.brandName') %>">
                        <img class="site-brand__logo" src="<%= img('/icons/naghshe-ara-logo.png', 160) %>"<%- responsive('/icons/naghshe-ara-logo.png', [160, 320], '80px') %> alt="<%= t('atelier.brandName') %>" width="1252" height="1151" decoding="async">
                    </a>
                    <p class="site-footer__text"><%= t('atelier.footerAbout') %></p>
                </div>
                <div>
                    <h3 class="site-footer__title"><%= t('atelier.explore') %></h3>
                    <div class="site-footer__links">
                        <a href="/<%= locale %>/products"><%= t('nav.products') %></a>
                        <a href="/<%= locale %>/projects"><%= t('nav.projects') %></a>
                        <a href="/<%= locale %>/articles"><%= t('nav.articles') %></a>
                        <a href="/<%= locale %>/contact"><%= t('nav.contact') %></a>
                        <% if (locale === 'fa') { %><a href="/fa/cities">ارسال به شهرها</a><% } %>                    </div>
                </div>
                <div>
                    <h3 class="site-footer__title"><%= t('atelier.atelierContact') %></h3>
                    <div class="site-footer__contact">
                        <a href="tel:+989124519443" class="ltr-text">+98 912 451 9443</a>
                        <a href="mailto:info@nashearatasfiyeh.com" class="ltr-text">info@nashearatasfiyeh.com</a>
                        <span><%= t('auto.k_f572ddf64198') %></span>
                        <span><%= t('auto.k_f9208a21604c') %></span>
                    </div>
                </div>
                <div>
                    <h3 class="site-footer__title"><%= t('atelier.newsletterTitle') %></h3>
                    <p class="site-footer__text" style="margin-top:0.4rem"><%= t('atelier.newsletterSub') %></p>
                    <form action="/<%= locale %>/newsletter/subscribe" method="POST" class="newsletter">
                        <input type="email" name="email" required placeholder="<%= t('atelier.newsletterPlaceholder') %>" aria-label="<%= t('atelier.newsletterPlaceholder') %>">
                        <button type="submit"><%= t('atelier.subscribe') %></button>
                    </form>
                </div>
            </div>
            <div class="site-footer__bottom">
                <p><%= t('atelier.rights').replace('©', '© ' + new Date().getFullYear() + ' ') %></p>
                <div class="flex items-center gap-5">
                    <span style="color:color-mix(in srgb, var(--color-bone) 78%, transparent)"><%= t("atelier.followUs") %></span>
                    <div class="site-footer__social">
                        <a href="https://www.instagram.com/nashearatasfiyeh" aria-label="Instagram" target="_blank" rel="noopener">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
                        </a>
                        <a href="https://t.me/nashearatasfiyeh" aria-label="Telegram" target="_blank" rel="noopener">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
                        </a>
                        <a href="https://wa.me/989124519443" aria-label="WhatsApp" target="_blank" rel="noopener">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-9 8.5 9.5 9.5 0 0 1-4.3-1.1L3 20l1.2-4.2A8.5 8.5 0 1 1 21 11.5Z"></path><path d="M8.2 8.3c.2-.5.4-.5.7-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.3.1.5-.1.7l-.5.6c.4.8 1.1 1.5 1.9 1.9l.6-.5c.2-.2.4-.2.7-.1l1.7.7c.3.1.4.3.4.5v.5c0 .3 0 .5-.5.7-.4.2-1 .3-1.5.1-2.2-.8-4-2.6-4.8-4.8-.2-.5-.1-1.1.1-1.5Z"></path></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <% if (!(currentPath && currentPath.startsWith('/visualizer'))) { %>
    <!-- A person is one tap away: WhatsApp chat with the workshop -->
    <a href="https://wa.me/989124519443" class="chat-fab" target="_blank" rel="noopener" aria-label="<%= t('atelier.whatsappCta') %>">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.2 21.8l4.9-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.2.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.8 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.3Z"/></svg>
        <span><%= t('atelier.whatsappCta') %></span>
    </a>
    <% } %>

    <% if (analytics.ga || analytics.clarity) { %><script src="<%= asset('/js/analytics.js') %>" data-ga="<%= analytics.ga %>" data-clarity="<%= analytics.clarity %>" defer></script><% } %>
    <script src="<%= asset('/js/reveal.js') %>" defer></script>
    <script src="<%= asset('/js/swatches.js') %>" defer></script>
    <script src="<%= asset('/js/site.js') %>" defer></script>
</body>

</html>
