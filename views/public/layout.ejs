    <style>
        @keyframes particle-0 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.4;
            }

            50% {
                transform: translateY(-15px) translateX(5px);
                opacity: 0.8;
            }
        }

        @keyframes particle-1 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.3;
            }

            50% {
                transform: translateY(-12px) translateX(-5px);
                opacity: 0.7;
            }
        }

        @keyframes particle-2 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.5;
            }

            50% {
                transform: translateY(-18px) translateX(8px);
                opacity: 0.9;
            }
        }

        @keyframes particle-3 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.4;
            }

            50% {
                transform: translateY(-10px) translateX(-3px);
                opacity: 0.8;
            }
        }

        @keyframes particle-4 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.3;
            }

            50% {
                transform: translateY(-14px) translateX(6px);
                opacity: 0.7;
            }
        }

        @keyframes particle-5 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.5;
            }

            50% {
                transform: translateY(-16px) translateX(-4px);
                opacity: 0.9;
            }
        }

        @keyframes particle-6 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.4;
            }

            50% {
                transform: translateY(-13px) translateX(7px);
                opacity: 0.8;
            }
        }

        @keyframes particle-7 {

            0%,
            100% {
                transform: translateY(0px) translateX(0px);
                opacity: 0.3;
            }

            50% {
                transform: translateY(-11px) translateX(-6px);
                opacity: 0.7;
            }
        }

        .particle-0 {
            animation: particle-0 3s ease-in-out 0s infinite normal none running;
        }

        .particle-1 {
            animation: particle-1 3s ease-in-out 0.3s infinite normal none running;
        }

        .particle-2 {
            animation: particle-2 3s ease-in-out 0.6s infinite normal none running;
        }

        .particle-3 {
            animation: particle-3 3s ease-in-out 0.9s infinite normal none running;
        }

        .particle-4 {
            animation: particle-4 3s ease-in-out 1.2s infinite normal none running;
        }

        .particle-5 {
            animation: particle-5 3s ease-in-out 1.5s infinite normal none running;
        }

        .particle-6 {
            animation: particle-6 3s ease-in-out 1.8s infinite normal none running;
        }

        .particle-7 {
            animation: particle-7 3s ease-in-out 2.1s infinite normal none running;
        }

        @keyframes scroll {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .animate-scroll {
            animation: scroll 30s linear infinite;
            display: flex;
            width: fit-content;
        }

        .animate-scroll:hover {
            animation-play-state: paused;
        }

        .clients-container {
            overflow: hidden;
            position: relative;
        }

        .clients-wrapper {
            display: flex;
            gap: 1.5rem;
            width: max-content;
        }

        @media (max-width: 768px) {
            .animate-scroll {
                animation-duration: 20s;
            }
        }

        .ltr-text {
            direction: ltr;
            text-align: left;
            unicode-bidi: embed;
        }
    </style>
</head>

