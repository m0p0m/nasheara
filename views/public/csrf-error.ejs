<section class="empty-state">
    <div class="container">
        <div class="empty-state__box">
            <span class="empty-state__code">403</span>
            <h1 class="empty-state__title"><%= t('pages.csrfTitle') %></h1>
            <%# Server messages are written in Persian; other languages get the general text. %>
            <p class="empty-state__text"><%= typeof errorMessage !== 'undefined' && locale === 'fa' ? errorMessage : t('pages.csrfText') %></p>
            <div class="empty-state__actions">
                <a href="/<%= locale %>/" class="btn btn-solid"><%= t('pages.backHome') %></a>
            </div>
        </div>
    </div>
</section>
