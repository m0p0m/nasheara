<section class="empty-state">
    <div class="container">
        <div class="empty-state__box">
            <span class="empty-state__code">403</span>
            <h1 class="empty-state__title">دسترسی نامعتبر</h1>
            <p class="empty-state__text"><%= typeof errorMessage !== 'undefined' ? errorMessage : 'درخواست شما معتبر نیست.' %></p>
            <div class="empty-state__actions">
                <a href="/<%= locale %>/" class="btn btn-solid">بازگشت به خانه</a>
            </div>
        </div>
    </div>
</section>
