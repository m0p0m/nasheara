<section class="empty-state">
    <div class="container">
        <div class="empty-state__box">
            <span class="empty-state__code"><%= (404).toLocaleString(locale === 'en' ? 'en' : (locale === 'ar' ? 'ar-EG' : 'fa-IR'), { useGrouping: false }) %></span>
            <h1 class="empty-state__title"><%= t('pages.notFoundTitle') %></h1>
            <p class="empty-state__text"><%= t('pages.notFoundText') %></p>
            <div class="empty-state__actions">
                <a href="/<%= locale %>/" class="btn btn-solid"><%= t('auto.k_1bd7e08e1679') %></a>
                <a href="/<%= locale %>/products" class="btn btn-outline"><%= t('auto.k_683dfe4e3a38') %></a>
            </div>
        </div>
    </div>
</section>
