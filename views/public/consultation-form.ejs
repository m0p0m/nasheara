<% const numLocale = locale === 'en' ? 'en' : (locale === 'ar' ? 'ar-EG' : 'fa-IR'); %>
<section class="section section--tone-bone page-top">
    <div class="container consult">
        <div class="consult__intro" data-reveal>
            <span class="eyebrow"><%= t('pages.consultEyebrow') %></span>
            <h1 class="section__title"><%= t('pages.consultTitle') %></h1>
            <p class="section__lead"><%= t('pages.consultLead') %></p>
        </div>

        <div class="consult-card" data-reveal style="--reveal-delay:120ms">
            <form action="/<%= locale %>/consultation" method="POST" id="contactForm" class="consult-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="contactTime" value="<%= t('auto.k_7334fd765cb9') %>">
                <% if (selectedProduct) { %>
                <input type="hidden" name="interestedInProduct" value="<%= selectedProduct %>">
                <p class="consult-context"><span><%= t('atelier.consultAbout') %></span> <strong><%= selectedProduct %></strong></p>
                <% } %>
                <div class="field">
                    <label for="consultName" class="field__label"><%= t('auto.k_2bae41dee0af') %> *</label>
                    <input id="consultName" name="name" type="text" autocomplete="name" required class="field__input"
                        placeholder="<%= t('auto.k_2a2bc8eb58e0') %>">
                </div>
                <div class="field">
                    <label for="consultPhone" class="field__label"><%= t('auto.k_ea8bbfa64be1') %> *</label>
                    <input id="consultPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required dir="ltr"
                        class="field__input ltr-text" placeholder="<%= t('forms.phonePlaceholder') %>">
                </div>
                <div class="field">
                    <label for="consultMessage" class="field__label"><%= t('pages.messageLabel') %></label>
                    <textarea id="consultMessage" name="message" rows="3" maxlength="600"
                        placeholder="<%= t('pages.messagePlaceholder') %>"><%= typeof note !== 'undefined' ? note : '' %></textarea>
                </div>
                <button type="submit" class="btn btn-brass w-full"><%= t('auto.k_fb8368590aaa') %></button>
                <p class="consult-form__privacy"><%= t('auto.k_cf2b64c81487') %></p>
            </form>
        </div>

        <div class="consult__more" data-reveal>
            <h2 class="consult__subtitle"><%= t('pages.nextTitle') %></h2>
            <ol class="consult__steps">
                <% [1, 2, 3].forEach(n => { %>
                <li class="consult__step">
                    <span class="process__num" aria-hidden="true"><%= n.toLocaleString(numLocale) %></span>
                    <div>
                        <h3 class="consult__step-title"><%= t('atelier.step' + n + 't') %></h3>
                        <p class="consult__step-text"><%= t('atelier.step' + n + 'd') %></p>
                    </div>
                </li>
                <% }); %>
            </ol>

            <div class="consult__direct hairline-t">
                <p class="label-caps"><%= t('pages.directTitle') %></p>
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-2">
                    <a href="tel:+989124519443" class="ltr-text font-semibold">+98 912 451 9443</a>
                    <a href="https://wa.me/989124519443" class="consult__link" target="_blank" rel="noopener"><%= t('atelier.whatsappCta') %></a>
                </div>
            </div>
        </div>

    </div>
</section>
