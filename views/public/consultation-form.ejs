<!-- Hero Section -->
<section class="consultation-page relative min-h-[50vh] overflow-hidden pt-20 section--tone-bone">
  <div class="container mx-auto px-4 relative z-10 py-16">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-2 border mb-6" style="border-color:var(--hairline);color:var(--color-brass)">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle w-4 h-4 text-[var(--accent)]">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        <span class="text-sm text-slate-500"><%= t('auto.k_5000708ab79f') %></span>
      </div>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight" style="color:var(--color-jade-deep)">
        <%= t('auto.k_a4a1baccd7b6') %>
      </h1>
      <p class="text-xl leading-relaxed" style="color:var(--color-stone)">
        <%= t('auto.k_b0074248138e') %>
      </p>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section id="contact" class="consultation-page py-16 md:py-24 section--tone-ivory relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-6"><%= t('auto.k_66f312339112') %></h2>
          <p class="text-slate-500 mb-8"><%= t('auto.k_542596510ae7') %></p>
        </div>

        <!-- Phone -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="contact-icon w-14 h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone w-7 h-7 text-white">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold"><%= t('auto.k_95ba75af28fb') %></h3>
              <a href="tel:+989124519443" dir="ltr" class="ltr-text block text-primary hover:text-[var(--accent)] transition-colors mb-1 font-semibold text-lg">+98 912 451 9443</a>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="contact-icon contact-icon--brass w-14 h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail w-7 h-7 text-white">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold"><%= t('auto.k_f1ad423d68cf') %></h3>
              <a href="mailto:info@nashearatasfiyeh.com" class="block text-primary hover:text-[var(--accent)] transition-colors mb-1 font-semibold">info@nashearatasfiyeh.com</a>
              <a href="mailto:support@nashearatasfiyeh.com" class="block text-primary hover:text-[var(--accent)] transition-colors font-semibold">support@nashearatasfiyeh.com</a>
            </div>
          </div>
        </div>

        <!-- Address -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="contact-icon w-14 h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-7 h-7 text-white">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold"><%= t('auto.k_efda82e0907c') %></h3>
              <p class="text-slate-500 leading-relaxed">
                <%= t('auto.k_f572ddf64198') %>
              </p>
            </div>
          </div>
        </div>

        <!-- Working Hours -->
        <div class="card-modern group">
          <div class="flex items-start gap-4">
            <div class="contact-icon contact-icon--brass w-14 h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-7 h-7 text-white">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg text-slate-900 mb-2 font-bold"><%= t('auto.k_73067610751c') %></h3>
              <p class="text-slate-500 mb-1"><%= t('auto.k_f9208a21604c') %></p>
              <p class="text-slate-500"><%= t('auto.k_c607363590f7') %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Map and Consultation Form -->
      <div class="space-y-8">
        <!-- Map -->
        <div class="card-modern !p-0 overflow-hidden">
          <div class="p-6 border-b border-gray-100">
            <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin text-primary">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <%= t('auto.k_59574024cb0b') %>
            </h3>
          </div>
        <div style="border-radius:0 0 1.5rem 1.5rem;overflow:hidden">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=51.38%2C35.69%2C51.42%2C35.71&layer=mapnik&marker=35.6994%2C51.4013"
            style="width:100%;height:384px;border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="<%= t('auto.k_31e3205ec015') %>">
          </iframe>
        </div>
        </div>

        <!-- Consultation Form -->
        <div class="card-modern !p-0 overflow-hidden">
          <div class="p-8 md:p-10">
            <div class="mb-8">
              <h3 class="text-2xl text-slate-900 mb-2 font-bold"><%= t('auto.k_8096ca39c908') %></h3>
              <p class="text-slate-500">
                <%= t('auto.k_f5d1091bfa55') %>
              </p>
            </div>
            <form action="/<%= locale %>/consultation" method="POST" class="space-y-6" id="contactForm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block mb-2 text-slate-900 font-semibold"><%= t('auto.k_2bae41dee0af') %> *</label>
                  <input name="name" required
                    class="input-field h-12"
                    placeholder="<%= t('auto.k_2a2bc8eb58e0') %>" />
                </div>
                <div>
                  <label class="block mb-2 text-slate-900 font-semibold"><%= t('auto.k_ea8bbfa64be1') %> *</label>
                  <input name="phone" required
                    dir="ltr" class="input-field h-12 ltr-text"
                    placeholder="<%= t('forms.phonePlaceholder') %>" />
                </div>
              </div>
              <input type="hidden" name="contactTime" value="<%= t('auto.k_7334fd765cb9') %>" />
              <div class="flex gap-4">
                <button type="submit"
                  class="btn-cta flex-1 flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-send w-5 h-5 group-hover:translate-x-1 transition-transform">
                    <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
                    <path d="m21.854 2.147-10.94 10.939"></path>
                  </svg>
                  <%= t('auto.k_fb8368590aaa') %>
                </button>

                <a href="tel:+989124519443"
                  class="btn-cta flex-1 flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-phone w-5 h-5">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                  <%= t('auto.k_69252c124a72') %>
                </a>
              </div>
              <p class="text-xs text-slate-500 text-center">
                <%= t('auto.k_cf2b64c81487') %>
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
