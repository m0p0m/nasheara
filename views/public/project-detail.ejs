<% if (project) { %>
<%
const projectImages = [project.coverImage, ...(project.galleryImages || [])]
    .filter(Boolean)
    .map(image => image.startsWith('http') ? image : siteUrl + image);
const projectStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title,
    description: project.description || undefined,
    image: projectImages,
    contentLocation: project.location ? { '@type': 'Place', name: project.location } : undefined,
    url: siteUrl + '/' + locale + '/project/' + encodeURIComponent(project.slug),
    creator: { '@type': 'Organization', name: t('atelier.brandName'), url: siteUrl },
    about: relatedProducts.map(p => ({ '@type': 'Product', name: p.name, url: siteUrl + '/' + locale + '/product/' + encodeURIComponent(p.slug) }))
};
// Each photo gets its own alt text: title, place and photo number.
const photoAlt = i => [project.title, project.location].filter(Boolean).join(' — ') + (i ? ' (' + (i + 1) + ')' : '');
const noteOf = p => [p.material, p.dimensions].filter(Boolean).join(' · ');
%>
<script type="application/ld+json"><%- JSON.stringify(projectStructuredData).replace(/</g, '\\u003c') %></script>

<section class="section section--tone-bone" style="padding-top:clamp(2rem,5vw,3.5rem)">
    <div class="container">
        <nav class="flex flex-wrap items-center gap-x-3 text-sm mb-10" style="color:var(--color-stone-ink)" data-reveal>
            <a href="/<%= locale %>/" class="hover:text-brass transition-colors inline-block py-2"><%= t('atelier.home') %></a>
            <span>/</span>
            <a href="/<%= locale %>/projects" class="hover:text-brass transition-colors inline-block py-2"><%= t('atelier.casesEyebrow') %></a>
            <span>/</span>
            <span class="text-ink"><%= project.title %></span>
        </nav>

        <div class="pdetail">
            <!-- Gallery -->
            <% const photos = [project.coverImage, ...(project.galleryImages || [])].filter(Boolean); const photoWidths = [800, 1280, 1600]; %>
            <div class="pdetail__media" data-gallery data-label-title="<%= project.title %>" data-label-close="<%= t('atelier.galleryClose') %>" data-label-prev="<%= t('atelier.galleryPrev') %>" data-label-next="<%= t('atelier.galleryNext') %>">
                <div class="pdetail__main pdetail__main--fit" data-reveal>
                    <% const mainImg = photos[0] || '/placeholder.jpg'; %>
                    <img data-gallery-main data-gallery-full="<%= img(mainImg, 2048) %>"
                        src="<%= img(mainImg, 1280) %>"<%- responsive(mainImg, photoWidths, '(min-width: 1024px) 50vw, 100vw') %>
                        alt="<%= photoAlt(0) %>" width="1200" height="900" fetchpriority="high" decoding="async">
                    <button type="button" class="pdetail__zoom" data-gallery-open aria-label="<%= t('atelier.galleryZoom') %>">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="m21 3-7 7"/><path d="m3 21 7-7"/></svg>
                    </button>
                </div>
                <% if (photos.length > 1) { %>
                    <div class="pdetail__thumbs pdetail__thumbs--spread" data-reveal style="--reveal-delay:100ms">
                        <% photos.forEach((image, i) => { %>
                            <button type="button" class="pdetail__thumb<%= i === 0 ? ' is-active' : '' %>" data-gallery-thumb="<%= img(image, 1280) %>" data-gallery-srcset="<%= srcset(image, photoWidths) %>" data-gallery-full="<%= img(image, 2048) %>" aria-label="<%= t('atelier.galleryPhoto', { n: i + 1 }) %>">
                                <img src="<%= img(image, 160) %>" alt="<%= photoAlt(i) %>" width="96" height="96" loading="lazy" decoding="async">
                            </button>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Info -->
            <div class="pdetail__info">
                <div data-reveal>
                    <% if (project.location) { %>
                        <span class="badge-flat mb-6"><%= project.location %></span>
                    <% } %>
                    <h1 class="pdetail__title"><%= project.title %></h1>
                </div>
                <% if (project.description) { %>
                    <div data-reveal style="--reveal-delay:100ms">
                        <p class="pdetail__lead" style="padding-bottom:0;border:0;white-space:pre-line"><%= project.description %></p>
                    </div>
                <% } %>
                <div class="mt-10 pt-8" data-reveal style="--reveal-delay:160ms">
                    <a href="/<%= locale %>/consultation" class="btn btn-brass"><%= t('atelier.requestConsultation') %></a>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('_video', { video: project.video, videoName: project.title, videoImage: project.coverImage || (project.galleryImages && project.galleryImages[0]) }) %>

<% if (relatedProducts && relatedProducts.length) { %>
<section class="section section--tone-ivory hairline-y">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.usedInThisProject') %></span>
            <h2 class="section__title"><%= t('atelier.related') %></h2>
        </div>
        <div class="editorial-grid">
            <% relatedProducts.forEach((rp, i) => { const cls = edCardClass(i, relatedProducts.length); %>
                <a href="/<%= locale %>/product/<%= encodeURIComponent(rp.slug) %>"
                    class="ed-card <%= cls %> group" data-reveal style="--reveal-delay:<%= i * 80 %>ms">
                    <div class="ed-card__media">
                        <img src="<%= img(rp.mainImage || '/placeholder.jpg', 480) %>"<%- responsive(rp.mainImage || '/placeholder.jpg', [320, 480, 640, 800, 1024], edCardSizes(cls)) %> alt="<%= rp.name %>" width="800" height="800" loading="lazy" decoding="async">
                    </div>
                    <div class="ed-card__body">
                        <% if (rp.category) { %><div class="ed-card__cat"><%= rp.category %></div><% } %>
                        <h3 class="ed-card__name"><%= rp.patternName || rp.name %></h3>
                        <p class="ed-card__note"><%= noteOf(rp) %></p>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<% } else { %>
<section class="section section--tone-bone text-center" style="padding-top:12rem;padding-bottom:12rem">
    <h1 class="text-3xl font-bold mb-6"><%= t('auto.k_e5e8c42f15c0') %></h1>
    <a href="/<%= locale %>/projects" class="btn btn-brass"><%= t('atelier.casesEyebrow') %></a>
</section>
<% } %>
