<% if (project) { %>
<%
const projectImages = [project.coverImage, ...(project.galleryImages || [])]
    .filter(Boolean)
    .map(image => image.startsWith('http') ? image : siteUrl + image);
const projectStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title,
    description: project.description || undefined,
    image: projectImages,
    contentLocation: project.location ? { '@type': 'Place', name: project.location } : undefined,
    url: siteUrl + '/project/' + encodeURIComponent(project.slug)
};
const noteOf = p => [p.material, p.dimensions].filter(Boolean).join(' · ');
%>
<script type="application/ld+json"><%- JSON.stringify(projectStructuredData).replace(/</g, '\\u003c') %></script>

<section class="section section--tone-bone" style="padding-top:clamp(6rem,12vw,9rem)">
    <div class="container">
        <nav class="flex items-center gap-3 text-sm mb-10" style="color:var(--color-stone)" data-reveal>
            <a href="/<%= locale %>/projects" class="hover:text-brass transition-colors"><%= t('atelier.casesEyebrow') %></a>
            <span>/</span>
            <span class="text-ink"><%= project.title %></span>
        </nav>

        <div class="pdetail">
            <!-- Gallery -->
            <div class="pdetail__media">
                <div class="pdetail__main" data-reveal>
                    <img id="projectMainImage"
                        src="<%= project.coverImage || (project.galleryImages && project.galleryImages[0]) || '/placeholder.jpg' %>"
                        alt="<%= project.title %>">
                </div>
                <% if (project.galleryImages && project.galleryImages.length) { %>
                    <div class="pdetail__thumbs pdetail__thumbs--spread" data-reveal style="--reveal-delay:100ms">
                        <% if (project.coverImage) { %>
                            <button type="button" class="pdetail__thumb is-active"
                                onclick="document.getElementById('projectMainImage').src=this.firstElementChild.getAttribute('src')">
                                <img src="<%= project.coverImage %>" alt="<%= project.title %>">
                            </button>
                        <% } %>
                        <% project.galleryImages.forEach(image => { %>
                            <button type="button" class="pdetail__thumb"
                                onclick="document.getElementById('projectMainImage').src=this.firstElementChild.getAttribute('src')">
                                <img src="<%= image %>" alt="<%= project.title %>">
                            </button>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Info -->
            <div class="pdetail__info">
                <div data-reveal>
                    <% if (project.location) { %>
                        <span class="badge-flat mb-6"><%= project.location %></span>
                    <% } %>
                    <h1 class="pdetail__title"><%= project.title %></h1>
                </div>
                <% if (project.description) { %>
                    <div data-reveal style="--reveal-delay:100ms">
                        <p class="pdetail__lead" style="padding-bottom:0;border:0"><%= project.description %></p>
                    </div>
                <% } %>
                <div class="mt-10 pt-8" data-reveal style="--reveal-delay:160ms">
                    <a href="/<%= locale %>/consultation" class="btn btn-brass"><%= t('atelier.requestConsultation') %></a>
                </div>
            </div>
        </div>
    </div>
</section>

<% if (relatedProducts && relatedProducts.length) { %>
<section class="section section--tone-ivory hairline-y">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.related') %></span>
            <h2 class="section__title"><%= t('atelier.related') %></h2>
        </div>
        <div class="editorial-grid">
            <% relatedProducts.forEach((rp, i) => { %>
                <a href="/<%= locale %>/product/<%= encodeURIComponent(rp.slug) %>"
                    class="ed-card <%= i === 0 ? 'ed-card--big' : 'ed-card--small' %> group" data-reveal style="--reveal-delay:<%= i * 80 %>ms">
                    <div class="ed-card__media">
                        <img src="<%= rp.mainImage || '/placeholder.jpg' %>" alt="<%= rp.name %>" loading="lazy">
                    </div>
                    <div class="ed-card__body">
                        <% if (rp.category) { %><div class="ed-card__cat"><%= rp.category %></div><% } %>
                        <h3 class="ed-card__name"><%= rp.patternName || rp.name %></h3>
                        <p class="ed-card__note"><%= noteOf(rp) %></p>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<% } else { %>
<section class="section section--tone-bone text-center" style="padding-top:12rem;padding-bottom:12rem">
    <h1 class="text-3xl font-bold mb-6"><%= t('auto.k_e5e8c42f15c0') %></h1>
    <a href="/<%= locale %>/projects" class="btn btn-brass"><%= t('atelier.casesEyebrow') %></a>
</section>
<% } %>
