<%
  const heroImage = '/icons/hero1.jpg';
  const noteOf = p => [p.material, p.dimensions].filter(Boolean).join(' · ');
%>

<!-- ===== Hero ===== -->
<section class="hero">
    <div class="hero__media">
        <img src="<%= img('/icons/1.png', 1600) %>"<%- responsive('/icons/1.png', [800, 1280, 1600, 2048], '100vw') %> alt="<%= t('atelier.brandName') %> — <%= t('atelier.brandTag') %>" width="1672" height="941" fetchpriority="high" decoding="async">
        <!-- <img src="<%= heroImage %>" alt="<%= t('atelier.brandTag') %>"> -->
    </div>
    <div class="hero__scrim"></div>
    <div class="container hero__inner">
        <div class="hero__content" data-reveal>
            <span class="eyebrow hero__eyebrow"><%= t('atelier.heroEyebrow') %></span>
            <h1 class="hero__title">
                <%= t('atelier.heroTitle') %><br>
                <span style="color:var(--color-brass)"><%= t('atelier.heroTitleAccent') %></span>
            </h1>
            <p class="hero__sub"><%= t('atelier.heroSub') %></p>
            <div class="hero__actions">
                <a href="/<%= locale %>/products" class="btn btn-brass"><%= t('atelier.heroCta') %></a>
                <a href="/<%= locale %>/visualizer" class="btn btn-outline-bone"><%= t('nav.visualizer') %></a>
            </div>
        </div>
    </div>
    <span class="hero__scroll"><%= t('atelier.scroll') %></span>
</section>

<% if (products && products.length > 0) { %>
<!-- ===== Swatch strip ===== -->
<section class="section section--tone-bone">
    <div class="container">
        <div class="swatches" data-swatches>
            <div class="swatch-preview" data-reveal>
                <img class="swatch-preview__img" data-swatch-img alt="">
                <div class="swatch-preview__fallback"><span></span></div>
                <div class="swatch-preview__meta">
                    <div>
                        <span class="swatch-preview__note" data-swatch-cat></span>
                        <p class="swatch-preview__name" data-swatch-name></p>
                    </div>
                    <span class="swatch-preview__note" data-swatch-note></span>
                </div>
            </div>
            <div class="swatch-panel">
                <div class="swatch-panel__head" data-reveal>
                    <span class="eyebrow"><%= t('atelier.swatchEyebrow') %></span>
                    <h2 class="section__title"><%= t('atelier.swatchTitle') %></h2>
                    <p class="section__lead"><%= t('atelier.swatchLead') %></p>
                </div>
                <div class="swatch-tray" data-reveal>
                    <% products.slice(0, 10).forEach(p => { %>
                        <button type="button" class="swatch" data-img="<%= p.mainImage ? img(p.mainImage, 800) : '' %>"
                            data-name="<%= p.patternName || p.name %>"
                            data-note="<%= noteOf(p) %>"
                            data-cat="<%= p.category || t('atelier.fromCollection') %>"
                            aria-label="<%= p.name %>">
                            <% if (p.mainImage) { %>
                                <img src="<%= img(p.mainImage, 160) %>" alt="<%= p.name %>" width="160" height="160" loading="lazy" decoding="async">
                            <% } else { %>
                                <span class="swatch--blank">✦</span>
                            <% } %>
                            <span class="swatch__name"><%= p.patternName || p.name %></span>
                        </button>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Featured / edited edit ===== -->
<section class="section section--tone-ivory">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.featuredEyebrow') %></span>
                <h2 class="section__title"><%= t('atelier.featuredTitle') %></h2>
                <p class="section__lead"><%= t('atelier.featuredLead') %></p>
            </div>
            <a href="/<%= locale %>/products" class="btn btn-outline btn--sm"><%= t('atelier.viewAll') %></a>
        </div>
        <div class="editorial-grid" data-reveal>
            <% products.slice(0, 8).forEach((p, i) => { %>
                <a href="/<%= locale %>/product/<%= encodeURIComponent(p.slug) %>"
                    class="ed-card <%= i === 0 ? 'ed-card--big' : 'ed-card--small' %> group">
                    <div class="ed-card__media">
                        <img src="<%= img(p.mainImage || '/icons/naghshe-ara-logo.png', 640) %>"<%- responsive(p.mainImage || '/icons/naghshe-ara-logo.png', [320, 480, 640, 800], '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw') %> alt="<%= p.patternName || p.name %>" width="800" height="800" loading="lazy" decoding="async">
                    </div>
                    <div class="ed-card__body">
                        <% if (p.category) { %><div class="ed-card__cat"><%= p.category %></div><% } %>
                        <h3 class="ed-card__name"><%= p.patternName || p.name %></h3>
                        <p class="ed-card__note"><%= noteOf(p) %></p>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Collections / categories ===== -->
<% if (categories && categories.length) { %>
<section class="section section--tone-bone hairline-y">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.collectionsEyebrow') %></span>
            <h2 class="section__title"><%= t('atelier.collectionsTitle') %></h2>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6" data-reveal>
            <% categories.forEach((cat, ci) => { %>
                <% const rep = (typeof products !== 'undefined' && products) ? products.find(p => p.category === cat.name && p.mainImage) : null; const catImg = cat.mainImage || (rep && rep.mainImage); %>
                <a href="/<%= locale %>/products?category=<%= encodeURIComponent(cat.name) %>"
                    class="group block">
                    <div class="overflow-hidden mb-4 cat-cover" style="border:1px solid var(--hairline);border-radius:var(--r-tight)">
                        <% if (catImg) { %>
                        <img src="<%= img(catImg, 480) %>"<%- responsive(catImg, [320, 480, 640], '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw') %> alt="<%= cat.name %>" width="600" height="750"
                            class="w-full aspect-[4/5] object-cover transition-transform duration-[900ms] group-hover:scale-105" loading="lazy">
                        <% } else { %>
                        <svg class="w-full aspect-[4/5] transition-transform duration-[900ms] group-hover:scale-105" viewBox="0 0 200 250" aria-hidden="true" style="display:block;background:color-mix(in srgb, var(--color-brass) 9%, var(--color-bone));color:var(--color-brass)">
                            <defs><pattern id="girih-<%= ci %>" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M20 0 L40 20 L20 40 L0 20 Z" fill="none" stroke="currentColor" stroke-width="0.9" opacity="0.55"/><path d="M20 9 L31 20 L20 31 L9 20 Z" fill="none" stroke="currentColor" stroke-width="0.9" opacity="0.55"/><circle cx="20" cy="20" r="2" fill="currentColor" opacity="0.6"/></pattern></defs>
                            <rect width="200" height="250" fill="url(#girih-<%= ci %>)"/>
                        </svg>
                        <% } %>
                    </div>
                    <h3 class="text-lg font-bold text-ink group-hover:text-brass transition-colors"><%= cat.name %></h3>
                    <span class="case__link mt-2"><%= t('atelier.moreInfo') %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </span>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Installed work (projects) ===== -->
<% if (projects && projects.length) { %>
<section class="section section--tone-ivory">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.casesEyebrow') %></span>
                <h2 class="section__title"><%= t('atelier.casesTitle') %></h2>
                <p class="section__lead"><%= t('atelier.casesLead') %></p>
            </div>
            <a href="/<%= locale %>/projects" class="btn btn-outline btn--sm"><%= t('atelier.allProjects') %></a>
        </div>
        <div class="space-y-16 lg:space-y-24">
            <% projects.slice(0, 3).forEach((proj, i) => { %>
                <a href="/<%= locale %>/project/<%= encodeURIComponent(proj.slug) %>"
                    class="case <%= i % 2 === 1 ? 'case--reverse' : '' %> group" data-reveal>
                    <div class="case__media">
                        <% const caseImg = proj.coverImage || (proj.galleryImages && proj.galleryImages[0]) || '/placeholder.jpg'; %>
                        <img src="<%= img(caseImg, 1024) %>"<%- responsive(caseImg, [640, 1024, 1280], '(min-width: 1024px) 50vw, 100vw') %>
                            alt="<%= proj.title %>" width="1200" height="900" loading="lazy" decoding="async">
                    </div>
                    <div class="case__body">
                        <div class="case__num">0<%= i + 1 %></div>
                        <% if (proj.location) { %><div class="case__location"><%= proj.location %></div><% } %>
                        <h3 class="case__title"><%= proj.title %></h3>
                        <p class="case__desc"><%= proj.description || '' %></p>
                        <span class="case__link"><%= t('atelier.viewCase') %>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </span>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Atelier statement ===== -->
<section class="section" style="background:var(--color-jade-deep);color:var(--color-bone)">
    <div class="container">
        <div class="grid lg:grid-cols-12 gap-10 items-end">
            <div class="lg:col-span-7" data-reveal>
                <span class="eyebrow" style="color:var(--color-brass)"><%= t('atelier.studioEyebrow') %></span>
                <h2 class="section__title mt-6" style="color:var(--color-bone);font-size:clamp(2.1rem,4.5vw,3.6rem)">
                    <%= t('atelier.studioTitle') %>
                </h2>
            </div>
            <div class="lg:col-span-5" data-reveal>
                <p style="color:color-mix(in srgb, var(--color-bone) 75%, transparent);font-size:1.02rem;line-height:2">
                    <%= t('atelier.studioLead') %>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ===== Testimonials ===== -->
<% if (testimonials && testimonials.length) { %>
<section class="section section--tone-bone hairline-y">
    <div class="container container--narrow">
        <div class="section__head text-center mx-auto" data-reveal>
            <span class="eyebrow eyebrow--plain justify-center"><%= t('atelier.testimonialsEyebrow') %></span>
            <h2 class="section__title mx-auto" style="text-align:center"><%= t('atelier.testimonialsTitle') %></h2>
        </div>
        <div class="grid md:grid-cols-<%= Math.min(3, testimonials.length) %> gap-10">
            <% testimonials.forEach((item, i) => { %>
            <figure class="quote" data-reveal style="--reveal-delay:<%= i * 120 %>ms">
                <div class="quote__stars" aria-label="<%= item.rating %>/5"><%= '★'.repeat(item.rating) %></div>
                <blockquote class="quote__text">«<%= item.text %>»</blockquote>
                <figcaption class="quote__person">
                    <span class="quote__avatar" aria-hidden="true"><%= String(item.name).trim().charAt(0) %></span>
                    <div>
                        <div class="quote__name"><%= item.name %></div>
                        <% if (item.location) { %><div class="quote__where"><%= item.location %></div><% } %>
                    </div>
                </figcaption>
            </figure>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Articles ===== -->
<% if (articles && articles.length) { %>
<section class="section section--tone-bone">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.articlesTitle') %></span>
                <h2 class="section__title"><%= t('atelier.articlesTitle') %></h2>
                <p class="section__lead"><%= t('atelier.articlesLead') %></p>
            </div>
            <a href="/<%= locale %>/articles" class="btn btn-outline btn--sm"><%= t('atelier.allArticles') %></a>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <% articles.slice(0, 3).forEach(a => { %>
                <a href="/<%= locale %>/article/<%= a.slug %>" class="group block" data-reveal>
                    <div class="overflow-hidden mb-5" style="border:1px solid var(--hairline);border-radius:var(--r-tight)">
                        <img src="<%= img(a.mainImage || '/placeholder.jpg', 640) %>"<%- responsive(a.mainImage || '/placeholder.jpg', [320, 480, 640, 800], '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw') %> alt="<%= a.title %>" width="1200" height="825" decoding="async"
                            class="w-full aspect-[16/11] object-cover transition-transform duration-[900ms] group-hover:scale-105" loading="lazy">
                    </div>
                    <h3 class="font-bold text-lg group-hover:text-brass transition-colors"><%= a.title %></h3>
                    <% if (a.excerpt) { %><p class="text-sm mt-2 line-clamp-2" style="color:var(--color-stone-ink)"><%= a.excerpt %></p><% } %>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Contact CTA ===== -->
<section class="section section--tone-ivory hairline-y">
    <div class="container container--narrow text-center">
        <div data-reveal>
            <span class="eyebrow eyebrow--plain justify-center"><%= t('atelier.atelierContact') %></span>
            <h2 class="section__title mx-auto" style="text-align:center"><%= t('atelier.contactTitle') %></h2>
            <p class="section__lead mx-auto" style="text-align:center"><%= t('atelier.contactLead') %></p>
        </div>
        <div class="flex flex-wrap justify-center gap-4 mt-10" data-reveal>
            <a href="/<%= locale %>/consultation" class="btn btn-brass"><%= t('atelier.consultCta') %></a>
            <a href="tel:+989124519443" class="btn btn-outline ltr-text">+98 912 451 9443</a>
        </div>
        <div class="grid sm:grid-cols-3 gap-6 mt-16 text-start" data-reveal>
            <div class="hairline-t pt-5">
                <div class="text-xs mb-2" style="color:var(--color-stone-ink);letter-spacing:0.14em"><%= t('auto.k_95ba75af28fb') %></div>
                <a href="tel:+989124519443" class="ltr-text font-semibold block">+98 912 451 9443</a>
            </div>
            <div class="hairline-t pt-5">
                <div class="text-xs mb-2" style="color:var(--color-stone-ink);letter-spacing:0.14em"><%= t('auto.k_f1ad423d68cf') %></div>
                <a href="mailto:info@nashearatasfiyeh.com" class="font-semibold">info@nashearatasfiyeh.com</a>
            </div>
            <div class="hairline-t pt-5">
                <div class="text-xs mb-2" style="color:var(--color-stone-ink);letter-spacing:0.14em"><%= t('auto.k_efda82e0907c') %></div>
                <p class="text-sm leading-relaxed"><%= t('auto.k_f572ddf64198') %></p>
            </div>
        </div>
    </div>
</section>
