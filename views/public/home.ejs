    <% if (articles && articles.length> 0) { %>
      <section class="py-20 bg-white">
        <div class="container">
          <div class="text-center mb-16">
            <h2 class="text-3xl lg:text-5xl font-bold mb-4">آخرین مطالب آموزشی</h2>
            <p class="text-slate-500">راهنمای تخصصی خرید و نگهداری دستگاه‌های تصفیه آب</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% articles.slice(0, 3).forEach(article=> { %>
              <a href="/article/<%= article.slug %>" class="card-modern group">
                <div class="overflow-hidden rounded-xl mb-4 h-52">
                  <img src="<%= article.mainImage || '/placeholder.jpg' %>"
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                </div>
                <h3 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">
                  <%= article.title %>
                </h3>
                <p class="text-sm text-slate-500 line-clamp-2 mb-4">
                  <%= article.excerpt %>
                </p>
                <span class="text-primary font-bold mt-auto flex items-center gap-2">
                  مطالعه مقاله
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6" />
                  </svg>
                </span>
              </a>
              <% }); %>
          </div>
        </div>
      </section>
