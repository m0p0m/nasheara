<%
  const heroImage = '/icons/hero1.jpg';
  const noteOf = p => [p.material, p.dimensions].filter(Boolean).join(' · ');
%>

<!-- ===== Hero ===== -->
<section class="hero">
    <div class="hero__media">
        <img src="<%= heroImage %>" alt="<%= t('atelier.brandTag') %>">
    </div>
    <div class="hero__scrim"></div>
    <div class="container hero__inner">
        <div class="hero__content" data-reveal>
            <span class="eyebrow hero__eyebrow"><%= t('atelier.heroEyebrow') %></span>
            <h1 class="hero__title">
                <%= t('atelier.heroTitle') %><br>
                <span style="color:var(--color-brass)"><%= t('atelier.heroTitleAccent') %></span>
            </h1>
            <p class="hero__sub"><%= t('atelier.heroSub') %></p>
            <div class="hero__actions">
                <a href="/<%= locale %>/products" class="btn btn-brass"><%= t('atelier.heroCta') %></a>
                <a href="/<%= locale %>/consultation" class="btn btn-outline-bone"><%= t('atelier.heroCta2') %></a>
            </div>
        </div>
    </div>
    <span class="hero__scroll"><%= t('atelier.scroll') %></span>
</section>

<% if (products && products.length > 0) { %>
<!-- ===== Swatch strip ===== -->
<section class="section section--tone-bone">
    <div class="container">
        <div class="swatches" data-swatches>
            <div class="swatch-preview" data-reveal>
                <img class="swatch-preview__img" data-swatch-img alt="">
                <div class="swatch-preview__fallback"><span></span></div>
                <div class="swatch-preview__meta">
                    <div>
                        <span class="swatch-preview__note" data-swatch-cat></span>
                        <h3 class="swatch-preview__name" data-swatch-name></h3>
                    </div>
                    <span class="swatch-preview__note" data-swatch-note></span>
                </div>
            </div>
            <div class="swatch-panel">
                <div class="swatch-panel__head" data-reveal>
                    <span class="eyebrow"><%= t('atelier.swatchEyebrow') %></span>
                    <h2 class="section__title"><%= t('atelier.swatchTitle') %></h2>
                    <p class="section__lead"><%= t('atelier.swatchLead') %></p>
                </div>
                <div class="swatch-tray" data-reveal>
                    <% products.slice(0, 10).forEach(p => { %>
                        <button type="button" class="swatch" data-img="<%= p.mainImage || '' %>"
                            data-name="<%= p.patternName || p.name %>"
                            data-note="<%= noteOf(p) %>"
                            data-cat="<%= p.category || t('atelier.fromCollection') %>"
                            aria-label="<%= p.name %>">
                            <% if (p.mainImage) { %>
                                <img src="<%= p.mainImage %>" alt="<%= p.name %>" loading="lazy">
                            <% } else { %>
                                <span class="swatch--blank">✦</span>
                            <% } %>
                            <span class="swatch__name"><%= p.patternName || p.name %></span>
                        </button>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Featured / edited edit ===== -->
<section class="section section--tone-ivory">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.featuredEyebrow') %></span>
                <h2 class="section__title"><%= t('atelier.featuredTitle') %></h2>
                <p class="section__lead"><%= t('atelier.featuredLead') %></p>
            </div>
            <a href="/<%= locale %>/products" class="btn btn-outline btn--sm"><%= t('atelier.viewAll') %></a>
        </div>
        <div class="editorial-grid" data-reveal>
            <% products.slice(0, 8).forEach((p, i) => { %>
                <a href="/<%= locale %>/product/<%= encodeURIComponent(p.slug) %>"
                    class="ed-card <%= i === 0 ? 'ed-card--big' : 'ed-card--small' %> group">
                    <div class="ed-card__media">
                        <img src="<%= p.mainImage || '/placeholder.jpg' %>" alt="<%= p.name %>" loading="lazy">
                    </div>
                    <div class="ed-card__body">
                        <% if (p.category) { %><div class="ed-card__cat"><%= p.category %></div><% } %>
                        <h3 class="ed-card__name"><%= p.patternName || p.name %></h3>
                        <p class="ed-card__note"><%= noteOf(p) %></p>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Collections / categories ===== -->
<% if (categories && categories.length) { %>
<section class="section section--tone-bone hairline-y">
    <div class="container">
        <div class="section__head" data-reveal>
            <span class="eyebrow"><%= t('atelier.collectionsEyebrow') %></span>
            <h2 class="section__title"><%= t('atelier.collectionsTitle') %></h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6" data-reveal>
            <% categories.forEach(cat => { %>
                <% const rep = (typeof products !== 'undefined' && products) ? products.find(p => p.category === cat.name) : null; %>
                <a href="/<%= locale %>/products?category=<%= encodeURIComponent(cat.name) %>"
                    class="group block">
                    <div class="overflow-hidden mb-4" style="border:1px solid var(--hairline);border-radius:var(--r-tight)">
                        <img src="<%= (rep && rep.mainImage) || '/uploads/naghsh_pages/page_1.png' %>" alt="<%= cat.name %>"
                            class="w-full aspect-[4/5] object-cover transition-transform duration-[900ms] group-hover:scale-105" loading="lazy">
                    </div>
                    <h3 class="text-lg font-bold text-ink group-hover:text-brass transition-colors"><%= cat.name %></h3>
                    <span class="case__link mt-2"><%= t('atelier.moreInfo') %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </span>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Installed work (projects) ===== -->
<% if (projects && projects.length) { %>
<section class="section section--tone-ivory">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.casesEyebrow') %></span>
                <h2 class="section__title"><%= t('atelier.casesTitle') %></h2>
                <p class="section__lead"><%= t('atelier.casesLead') %></p>
            </div>
            <a href="/<%= locale %>/projects" class="btn btn-outline btn--sm"><%= t('atelier.allProjects') %></a>
        </div>
        <div class="space-y-16 lg:space-y-24">
            <% projects.slice(0, 3).forEach((proj, i) => { %>
                <a href="/<%= locale %>/project/<%= encodeURIComponent(proj.slug) %>"
                    class="case <%= i % 2 === 1 ? 'case--reverse' : '' %> group" data-reveal>
                    <div class="case__media">
                        <img src="<%= proj.coverImage || (proj.galleryImages && proj.galleryImages[0]) || '/placeholder.jpg' %>"
                            alt="<%= proj.title %>" loading="lazy">
                    </div>
                    <div class="case__body">
                        <div class="case__num">0<%= i + 1 %></div>
                        <% if (proj.location) { %><div class="case__location"><%= proj.location %></div><% } %>
                        <h3 class="case__title"><%= proj.title %></h3>
                        <p class="case__desc"><%= proj.description || '' %></p>
                        <span class="case__link"><%= t('atelier.viewCase') %>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </span>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Atelier statement ===== -->
<section class="section" style="background:var(--color-jade-deep);color:var(--color-bone)">
    <div class="container">
        <div class="grid lg:grid-cols-12 gap-10 items-end">
            <div class="lg:col-span-7" data-reveal>
                <span class="eyebrow" style="color:var(--color-brass)"><%= t('atelier.studioEyebrow') %></span>
                <h2 class="section__title mt-6" style="color:var(--color-bone);font-size:clamp(2.1rem,4.5vw,3.6rem)">
                    <%= t('atelier.studioTitle') %>
                </h2>
            </div>
            <div class="lg:col-span-5" data-reveal>
                <p style="color:color-mix(in srgb, var(--color-bone) 75%, transparent);font-size:1.02rem;line-height:2">
                    <%= t('atelier.studioLead') %>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ===== Testimonials ===== -->
