<section id="home" class="relative pt-32 lg:pt-48 pb-20 overflow-hidden">
  <div class="container hero-grid">
    <div class="flex flex-col items-center lg:items-start space-y-8">
      <div class="inline-flex px-4 py-2 bg-white rounded-full border border-slate-200 text-sm font-bold text-slate-500">
        تکنولوژی روز تصفیه آب</div>
      <h1 class="text-4xl lg:text-6xl font-black text-slate-900 leading-tight text-center lg:text-right">
        آب سالم،<br><span class="text-primary">زندگی سالم با صبا تصفیه</span>
      </h1>
      <p class="text-lg text-slate-600 max-w-xl text-center lg:text-right leading-relaxed">
      طراح و تولید کننده سیستم های تصفیه آب صنعتی، نیمه‌صنعتی و خانگی با بیش از ۱۵ سال سابقه درخشان.
      </p>
      <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
        <a href="/consultation" class="btn-cta">مشاوره رایگان</a>
        <a href="/products" class="btn-secondary">محصولات ما</a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4 relative">
      <div class="absolute -top-10 -left-10 w-40 h-40 bg-primary/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="col-span-2 relative group overflow-hidden rounded-3xl shadow-2xl">
        <img src="/icons/hero1.jpg"
          class="w-full h-64 lg:h-96 object-cover transform group-hover:scale-105 transition-transform duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-dark/60 to-transparent"></div>
      </div>
      <div class="col-span-1 relative group overflow-hidden rounded-2xl shadow-lg">
        <img src="/icons/hero3.jpg"
          class="w-full h-40 lg:h-56 object-cover transform group-hover:scale-110 transition-transform duration-500">
      </div>
      <div class="col-span-1 relative group overflow-hidden rounded-2xl shadow-lg">
        <img src="/icons/hero2.jpg"
          class="w-full h-40 lg:h-56 object-cover transform group-hover:scale-110 transition-transform duration-500">
      </div>
    </div>
  </div>
</section>



<% if (products && products.length> 0) { %>
  <section class="py-20 bg-slate-50">
    <div class="container">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-5xl font-bold mb-4">محصولات منتخب</h2>
        <p class="text-slate-500">بهترین انتخاب‌ها برای سلامت شما</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        <% products.slice(0, 8).forEach(product=> { %>
          <a href="/product/<%= encodeURIComponent(product.slug) %>" class="card-modern !p-3 sm:!p-4">
            <div class="aspect-square rounded-xl overflow-hidden mb-4 bg-slate-100">
              <img src="<%= product.mainImage || '/placeholder.jpg' %>"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            </div>
            <h3 class="text-xs sm:text-sm lg:text-base font-bold line-clamp-2 mb-4 flex-grow h-10 sm:h-12">
              <%= product.name %>
            </h3>
            <span class="btn-primary !h-9 sm:!h-10 !text-[10px] sm:!text-xs !w-full">مشاهده جزئیات</span>
          </a>
          <% }); %>
      </div>
      <div class="text-center mt-12">
        <a href="/products" class="btn-primary">مشاهده تمامی محصولات</a>
      </div>
    </div>
  </section>
  <% } %>

