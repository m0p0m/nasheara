<%
  const noteOf = p => [p.material, p.dimensions].filter(Boolean).join(' · ');
%>

<!-- ===== Hero ===== -->
<section class="hero">
    <div class="hero__media">
        <img src="<%= img('/icons/1.png', 1600) %>"<%- responsive('/icons/1.png', [800, 1280, 1600, 2048], '100vw') %> alt="<%= t('atelier.brandName') %> — <%= t('atelier.brandTag') %>" width="1672" height="941" fetchpriority="high" decoding="async">
        <% if (heroVideo) { %>
        <!-- Workshop film: drop public/media/hero.mp4 (+ optional hero.webm) on the server -->
        <video autoplay muted loop playsinline preload="metadata" poster="<%= img('/icons/1.png', 1600) %>" aria-hidden="true" tabindex="-1">
            <% if (heroVideo.webm) { %><source src="<%= heroVideo.webm %>" type="video/webm"><% } %>
            <source src="<%= heroVideo.mp4 %>" type="video/mp4">
        </video>
        <% } %>
    </div>
    <div class="hero__scrim"></div>
    <div class="container hero__inner">
        <div class="hero__content" data-reveal>
            <span class="eyebrow hero__eyebrow"><%= t('atelier.heroEyebrow') %></span>
            <h1 class="hero__title">
                <%= t('atelier.heroTitle') %><br>
                <span class="hero__accent"><%= t('atelier.heroTitleAccent') %></span>
            </h1>
            <p class="hero__sub"><%= t('atelier.heroSub') %></p>
            <div class="hero__actions">
                <a href="/<%= locale %>/products" class="btn btn-brass"><%= t('atelier.heroCta') %></a>
                <a href="/<%= locale %>/visualizer" class="btn btn-outline-bone"><%= t('nav.visualizer') %></a>
            </div>
        </div>
    </div>
    <a href="#collection" class="hero__scroll" aria-label="<%= t('atelier.heroCta') %>"><i></i></a>
</section>

<!-- ===== Promise strip: what every order gets ===== -->
<section class="promise" id="collection" aria-label="<%= t('atelier.promiseLabel') %>">
    <div class="container">
        <ul class="promise__list">
            <li class="promise__item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11V6.5a1.5 1.5 0 0 1 3 0V11"/><path d="M10 10V4.5a1.5 1.5 0 0 1 3 0V10"/><path d="M13 10V5.5a1.5 1.5 0 0 1 3 0V12"/><path d="M16 11.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-4.9-2.6L4.2 14.6a1.6 1.6 0 0 1 2.5-2L8 14V11a1.5 1.5 0 0 1 3 0"/></svg>
                <div><strong><%= t('atelier.promise1t') %></strong><span><%= t('atelier.promise1d') %></span></div>
            </li>
            <li class="promise__item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12Z"/><path d="M8.5 10.5h7M8.5 13.5h4.5"/></svg>
                <div><strong><%= t('atelier.promise2t') %></strong><span><%= t('atelier.promise2d') %></span></div>
            </li>
            <li class="promise__item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><path d="M13 17h8M17 13v8"/></svg>
                <div><strong><%= t('atelier.promise3t') %></strong><span><%= t('atelier.promise3d') %></span></div>
            </li>
            <li class="promise__item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
                <div><strong><%= t('atelier.promise4t') %></strong><span><%= t('atelier.promise4d') %></span></div>
            </li>
        </ul>
    </div>
</section>

<% if (products && products.length > 0) { %>
<!-- ===== Swatch strip ===== -->
<section class="section section--tone-glaze">
    <div class="container">
        <div class="swatches" data-swatches>
            <div class="swatch-preview" data-reveal>
                <img class="swatch-preview__img" data-swatch-img alt="">
                <div class="swatch-preview__fallback"><span></span></div>
                <div class="swatch-preview__meta">
                    <div>
                        <span class="swatch-preview__note" data-swatch-cat></span>
                        <p class="swatch-preview__name" data-swatch-name></p>
                    </div>
                    <span class="swatch-preview__note" data-swatch-note></span>
                </div>
            </div>
            <div class="swatch-panel">
                <div class="swatch-panel__head" data-reveal>
                    <span class="eyebrow"><%= t('atelier.swatchEyebrow') %></span>
                    <h2 class="section__title"><%= t('atelier.swatchTitle') %></h2>
                    <p class="section__lead"><%= t('atelier.swatchLead') %></p>
                </div>
                <div class="swatch-tray" data-reveal>
                    <% products.slice(0, 10).forEach(p => { %>
                        <button type="button" class="swatch" data-img="<%= p.mainImage ? img(p.mainImage, 800) : '' %>"
                            data-name="<%= p.patternName || p.name %>"
                            data-note="<%= noteOf(p) %>"
                            data-cat="<%= p.category || t('atelier.fromCollection') %>"
                            aria-label="<%= p.name %>">
                            <% if (p.mainImage) { %>
                                <img src="<%= img(p.mainImage, 160) %>" alt="<%= p.name %>" width="160" height="160" loading="lazy" decoding="async">
                            <% } else { %>
                                <span class="swatch--blank">✦</span>
                            <% } %>
                            <span class="swatch__name"><%= p.patternName || p.name %></span>
                        </button>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Featured: specimens on a tile wall ===== -->
<section class="section section--tone-ivory">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.featuredEyebrow') %></span>
                <h2 class="section__title"><%= t('atelier.featuredTitle') %></h2>
                <p class="section__lead"><%= t('atelier.featuredLead') %></p>
            </div>
            <a href="/<%= locale %>/products" class="btn btn-outline btn--sm"><%= t('atelier.viewAll') %></a>
        </div>
        <% const homeCount = Math.min(products.length, 8); %>
        <div class="tile-wall tile-wall--home<%= homeCount % 4 !== 0 && homeCount % 3 === 0 ? ' tile-wall--3' : '' %>">
            <% products.slice(0, 8).forEach((p, i) => { %>
                <%- include('_tile-card', { p, i, headingTag: 'h3', sizes: '(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 46vw' }) %>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Collections: each one a glazed tile with its own pattern ===== -->
<% if (categories && categories.length) { %>
<section class="section section--tone-bone hairline-y cv-auto">
    <svg class="sr-only" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <pattern id="glz-star" width="48" height="48" patternUnits="userSpaceOnUse">
                <path d="M24 4 30 18 44 24 30 30 24 44 18 30 4 24 18 18Z M10 10H38V38H10Z" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="24" cy="24" r="3" fill="currentColor"/><circle cx="0" cy="0" r="3" fill="currentColor"/><circle cx="48" cy="0" r="3" fill="currentColor"/><circle cx="0" cy="48" r="3" fill="currentColor"/><circle cx="48" cy="48" r="3" fill="currentColor"/>
            </pattern>
            <pattern id="glz-hex" width="42" height="72.75" patternUnits="userSpaceOnUse">
                <path d="M21 0 42 12.1V36.4L21 48.5 0 36.4V12.1Z M21 48.5V72.75 M0 36.4 0 60.6 M42 36.4V60.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <path d="M21 14 33 21V35L21 42 9 35V21Z" fill="currentColor" opacity=".35"/>
            </pattern>
            <pattern id="glz-lozi" width="36" height="36" patternUnits="userSpaceOnUse">
                <path d="M18 0 36 18 18 36 0 18Z" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <path d="M18 9 27 18 18 27 9 18Z" fill="currentColor" opacity=".4"/>
            </pattern>
            <pattern id="glz-flower" width="40" height="40" patternUnits="userSpaceOnUse">
                <circle cx="0" cy="0" r="14" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="40" cy="0" r="14" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="0" cy="40" r="14" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="40" cy="40" r="14" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <path d="M20 12 22.5 17.5 28 20 22.5 22.5 20 28 17.5 22.5 12 20 17.5 17.5Z" fill="currentColor"/>
            </pattern>
        </defs>
    </svg>
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.collectionsEyebrow') %></span>
                <h2 class="section__title"><%= t('atelier.collectionsTitle') %></h2>
            </div>
            <a href="/<%= locale %>/products" class="btn btn-outline btn--sm"><%= t('atelier.viewAll') %></a>
        </div>
        <div class="glaze-wall" style="--glaze-cols:<%= Math.min(Math.max(categories.length, 2), 4) %>">
            <% const glazes = ['star', 'hex', 'lozi', 'flower']; %>
            <% categories.forEach((cat, ci) => { const g = glazes[ci % glazes.length]; %>
                <a href="/<%= locale %>/category/<%= encodeURIComponent(cat.slug) %>" class="glaze-tile glaze-tile--<%= g %>" data-reveal style="--reveal-delay:<%= ci * 90 %>ms">
                    <svg class="glaze-tile__pattern" aria-hidden="true" focusable="false"><rect width="100%" height="100%" fill="url(#glz-<%= g %>)"/></svg>
                    <% if (cat.mainImage) { %>
                    <span class="glaze-tile__gem">
                        <img src="<%= img(cat.mainImage, 320) %>"<%- responsive(cat.mainImage, [160, 320, 480], '(min-width: 1024px) 12vw, 26vw') %> alt="" width="320" height="320" loading="lazy" decoding="async">
                    </span>
                    <% } %>
                    <span class="glaze-tile__plate">
                        <span class="glaze-tile__name"><%= cat.name %></span>
                        <span class="glaze-tile__meta">
                            <% if (cat.count) { %><%= t('atelier.patternsCount', { n: cat.count.toLocaleString(locale === 'en' ? 'en' : (locale === 'ar' ? 'ar-EG' : 'fa-IR')) }) %><% } else { %><%= t('atelier.moreInfo') %><% } %>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </span>
                    </span>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Installed work (projects) ===== -->
<% if (projects && projects.length) { %>
<section class="section section--tone-ivory">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.casesEyebrow') %></span>
                <h2 class="section__title"><%= t('atelier.casesTitle') %></h2>
                <p class="section__lead"><%= t('atelier.casesLead') %></p>
            </div>
            <a href="/<%= locale %>/projects" class="btn btn-outline btn--sm"><%= t('atelier.allProjects') %></a>
        </div>
        <div class="space-y-16 lg:space-y-24">
            <% projects.slice(0, 3).forEach((proj, i) => { %>
                <a href="/<%= locale %>/project/<%= encodeURIComponent(proj.slug) %>"
                    class="case <%= i % 2 === 1 ? 'case--reverse' : '' %> group" data-reveal>
                    <div class="case__media">
                        <% const caseImg = proj.coverImage || (proj.galleryImages && proj.galleryImages[0]) || '/placeholder.jpg'; %>
                        <img src="<%= img(caseImg, 1024) %>"<%- responsive(caseImg, [640, 1024, 1280], '(min-width: 1024px) 50vw, 100vw') %>
                            alt="<%= proj.title %>" width="1200" height="900" loading="lazy" decoding="async">
                    </div>
                    <div class="case__body">
                        <% if (proj.location) { %><div class="case__location"><%= proj.location %></div><% } %>
                        <h3 class="case__title"><%= proj.title %></h3>
                        <p class="case__desc"><%= proj.description || '' %></p>
                        <span class="case__link"><%= t('atelier.viewCase') %>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </span>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== How an order works: a real four-step sequence ===== -->
<section class="section process">
    <div class="container">
        <div class="process__head">
            <h2 class="section__title"><%= t('atelier.processTitle') %></h2>
            <p class="process__lead"><%= t('atelier.studioLead') %></p>
        </div>
        <ol class="process__steps">
            <% [1, 2, 3, 4].forEach(n => { %>
            <li class="process__step" data-reveal style="--reveal-delay:<%= (n - 1) * 120 %>ms">
                <span class="process__num" aria-hidden="true"><%= n.toLocaleString(locale === 'en' ? 'en' : (locale === 'ar' ? 'ar-EG' : 'fa-IR')) %></span>
                <h3 class="process__title"><%= t('atelier.step' + n + 't') %></h3>
                <p class="process__text"><%= t('atelier.step' + n + 'd') %></p>
            </li>
            <% }); %>
        </ol>
        <div class="process__actions">
            <a href="/<%= locale %>/consultation" class="btn btn-brass"><%= t('atelier.processCta') %></a>
            <a href="https://wa.me/989124519443" class="btn btn-outline-bone" target="_blank" rel="noopener"><%= t('atelier.whatsappCta') %></a>
        </div>
    </div>
</section>

<!-- ===== Testimonials ===== -->
<% if (testimonials && testimonials.length) { %>
<section class="section section--tone-bone hairline-y">
    <div class="container container--narrow">
        <div class="section__head text-center mx-auto" data-reveal>
            <span class="eyebrow eyebrow--plain justify-center"><%= t('atelier.testimonialsEyebrow') %></span>
            <h2 class="section__title mx-auto" style="text-align:center"><%= t('atelier.testimonialsTitle') %></h2>
        </div>
        <div class="grid md:grid-cols-<%= Math.min(3, testimonials.length) %> gap-10">
            <% testimonials.forEach((item, i) => { %>
            <figure class="quote" data-reveal style="--reveal-delay:<%= i * 120 %>ms">
                <div class="quote__stars" aria-label="<%= item.rating %>/5"><%= '★'.repeat(item.rating) %></div>
                <blockquote class="quote__text">«<%= item.text %>»</blockquote>
                <figcaption class="quote__person">
                    <span class="quote__avatar" aria-hidden="true"><%= String(item.name).trim().charAt(0) %></span>
                    <div>
                        <div class="quote__name" aria-hidden="true"><%= item.name %></div>
                        <% if (item.location) { %><div class="quote__where"><%= item.location %></div><% } %>
                    </div>
                </figcaption>
            </figure>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Articles ===== -->
<% if (articles && articles.length) { %>
<section class="section section--tone-bone">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('nav.articles') %></span>
                <h2 class="section__title"><%= t('atelier.articlesTitle') %></h2>
                <p class="section__lead"><%= t('atelier.articlesLead') %></p>
            </div>
            <a href="/<%= locale %>/articles" class="btn btn-outline btn--sm"><%= t('atelier.allArticles') %></a>
        </div>
        <div class="article-grid">
            <% articles.slice(0, 3).forEach((a, i) => { %><%- include('_article-card', { a, i }) %><% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ===== Contact CTA ===== -->
<section class="section section--tone-glaze">
    <div class="container container--narrow text-center">
        <div data-reveal>
            <span class="eyebrow eyebrow--plain justify-center"><%= t('atelier.atelierContact') %></span>
            <h2 class="section__title mx-auto" style="text-align:center"><%= t('atelier.contactTitle') %></h2>
            <p class="section__lead mx-auto" style="text-align:center"><%= t('atelier.contactLead') %></p>
        </div>
        <div class="flex flex-wrap justify-center gap-4 mt-10" data-reveal>
            <a href="/<%= locale %>/consultation" class="btn btn-brass"><%= t('atelier.consultCta') %></a>
            <a href="https://wa.me/989124519443" class="btn btn-outline" target="_blank" rel="noopener"><%= t('atelier.whatsappCta') %></a>
        </div>
        <div class="grid sm:grid-cols-3 gap-6 mt-16 text-start" data-reveal>
            <div class="hairline-t pt-5">
                <div class="label-caps mb-2"><%= t('auto.k_95ba75af28fb') %></div>
                <a href="tel:+989124519443" class="ltr-text font-semibold block">+98 912 451 9443</a>
            </div>
            <div class="hairline-t pt-5">
                <div class="label-caps mb-2"><%= t('auto.k_f1ad423d68cf') %></div>
                <a href="mailto:info@nashearatasfiyeh.com" class="ltr-text font-semibold">info@nashearatasfiyeh.com</a>
            </div>
            <div class="hairline-t pt-5">
                <div class="label-caps mb-2"><%= t('auto.k_efda82e0907c') %></div>
                <p class="text-sm leading-relaxed"><%= t('auto.k_f572ddf64198') %></p>
            </div>
        </div>
    </div>
</section>
