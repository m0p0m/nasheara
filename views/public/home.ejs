    <div class="container container--narrow">
        <div class="section__head text-center mx-auto" data-reveal>
            <span class="eyebrow eyebrow--plain justify-center"><%= t('atelier.testimonialsEyebrow') %></span>
            <h2 class="section__title mx-auto" style="text-align:center"><%= t('atelier.testimonialsTitle') %></h2>
        </div>
        <div class="grid md:grid-cols-3 gap-10">
            <div class="quote" data-reveal>
                <div class="quote__stars">★★★★★</div>
                <p class="quote__text">«<%= t('auto.k_b32769d3f965') %></p>
                <div class="quote__person">
                    <span class="quote__avatar"><%= t('auto.k_80add0b9e028') %></span>
                    <div>
                        <div class="quote__name"><%= t('auto.k_ef96e9d7f072') %></div>
                        <div class="quote__where"><%= t('auto.k_352a9115c09a') %></div>
                    </div>
                </div>
            </div>
            <div class="quote" data-reveal style="--reveal-delay:120ms">
                <div class="quote__stars">★★★★★</div>
                <p class="quote__text">«<%= t('auto.k_1ec0b204ad83') %></p>
                <div class="quote__person">
                    <span class="quote__avatar"><%= t('auto.k_d8fe6f076d79') %></span>
                    <div>
                        <div class="quote__name"><%= t('auto.k_4e7ed49cad40') %></div>
                        <div class="quote__where"><%= t('auto.k_352a9115c09a') %></div>
                    </div>
                </div>
            </div>
            <div class="quote" data-reveal style="--reveal-delay:240ms">
                <div class="quote__stars">★★★★★</div>
                <p class="quote__text">«<%= t('auto.k_bc27af2206b7') %></p>
                <div class="quote__person">
                    <span class="quote__avatar"><%= t('auto.k_84be511ca748') %></span>
                    <div>
                        <div class="quote__name"><%= t('auto.k_cf17fd2cc1f6') %></div>
                        <div class="quote__where"><%= t('auto.k_f73693f90702') %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== Articles ===== -->
<% if (articles && articles.length) { %>
<section class="section section--tone-bone">
    <div class="container">
        <div class="section__head flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
                <span class="eyebrow"><%= t('atelier.articlesTitle') %></span>
                <h2 class="section__title"><%= t('atelier.articlesTitle') %></h2>
                <p class="section__lead"><%= t('atelier.articlesLead') %></p>
            </div>
            <a href="/<%= locale %>/articles" class="btn btn-outline btn--sm"><%= t('auto.k_46dd186fe2eb') %></a>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <% articles.slice(0, 3).forEach(a => { %>
                <a href="/<%= locale %>/article/<%= a.slug %>" class="group block" data-reveal>
                    <div class="overflow-hidden mb-5" style="border:1px solid var(--hairline);border-radius:var(--r-tight)">
                        <img src="<%= a.mainImage || '/placeholder.jpg' %>" alt="<%= a.title %>"
                            class="w-full aspect-[16/11] object-cover transition-transform duration-[900ms] group-hover:scale-105" loading="lazy">
                    </div>
                    <h3 class="font-bold text-lg group-hover:text-brass transition-colors"><%= a.title %></h3>
                    <% if (a.excerpt) { %><p class="text-sm mt-2 line-clamp-2" style="color:var(--color-stone)"><%= a.excerpt %></p><% } %>
                </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

