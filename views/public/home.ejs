                          <label class="block mb-2 text-slate-900 font-semibold">نام و نام خانوادگی *</label>
                          <input name="name" required class="input-field h-12"
                            placeholder="نام کامل خود را وارد کنید" />
                        </div>
                        <div>
                          <label class="block mb-2 text-slate-900 font-semibold">شماره تماس *</label>
                          <input name="phone" required class="input-field h-12 dir-ltr text-right"
                            placeholder="۰۹۱۲-۳۴۵-۶۷۸۹" />
                        </div>
                      </div>
