    <div class="max-w-2xl mx-auto bg-white rounded-3xl p-8 md:p-12 shadow-xl text-center border border-slate-100">
      <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-8 animate-bounce">
        <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h1 class="text-3xl md:text-4xl font-black text-slate-900 mb-4">
        <%= typeof heading !== 'undefined' ? heading : t('auto.k_5c52616718c1') %>
