      <p class="text-lg text-slate-600 mb-10 leading-relaxed">
        <%= typeof message !== 'undefined' ? message : t('auto.k_4cd08e174103') %>
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/<%= locale %>/" class="btn-primary">
          <%= t('auto.k_1bd7e08e1679') %>
        </a>
        <a href="/<%= locale %>/products" class="btn-secondary">
          <%= t('auto.k_683dfe4e3a38') %>
        </a>
      </div>
    </div>
  </div>
</section>
