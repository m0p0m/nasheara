<% if (article) { %>
<!-- Hero Section -->
<section class="relative min-h-[50vh] overflow-hidden pt-20 bg-gradient-to-br from-[var(--bg-milky)] via-white to-[var(--bg-milky)]">
  <div class="container mx-auto px-4 relative z-10 py-16">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full border border-[var(--primary)]/10 shadow-sm mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open w-4 h-4 text-[var(--accent)]">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
        <span class="text-sm text-slate-500">مقاله</span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6 leading-tight">
        <%= article.title %>
      </h1>
      <div class="flex items-center justify-center gap-4 text-slate-500">
        <span class="text-sm">
          <%= new Date(article.createdAt).toLocaleDateString('fa-IR') %>
        </span>
      </div>
    </div>
  </div>
</section>

<!-- Article Content -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <% if (article.mainImage) { %>
      <div class="mb-12 rounded-3xl overflow-hidden shadow-2xl">
        <img src="<%= article.mainImage %>" alt="<%= article.title %>" class="w-full h-auto object-cover">
      </div>
      <% } %>

      <article class="prose prose-lg max-w-none">
        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8 md:p-12">
          <div class="text-slate-900 leading-relaxed prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-ul:list-disc prose-ul:pr-6 prose-ol:pr-6 prose-img:rounded-2xl prose-img:shadow-lg">
            <%- articleHtml %>
          </div>
        </div>
      </article>

      <div class="mt-12 pt-8 border-t border-gray-200">
        <a href="/articles"
          class="inline-flex items-center gap-2 text-primary hover:text-[var(--accent)] transition-colors font-semibold">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="lucide lucide-arrow-right">
            <path d="m12 19 7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          بازگشت به لیست مقالات
        </a>
      </div>
    </div>
  </div>
</section>
<% } else { %>
<section class="py-24 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center py-20">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[var(--bg-milky)] mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-alert-circle text-primary">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <h2 class="text-3xl font-bold text-slate-900 mb-4">مقاله یافت نشد</h2>
      <p class="text-slate-500 mb-8">مقاله مورد نظر شما وجود ندارد یا حذف شده است.</p>
      <a href="/articles"
        class="inline-flex items-center gap-2 bg-primary text-white btn-primary flex ">
        بازگشت به لیست مقالات
      </a>
    </div>
  </div>
</section>
<% } %>
