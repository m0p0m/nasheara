<% if (article) { %>
<% const localeCode = locale === 'fa' ? 'fa-IR' : locale === 'ar' ? 'ar-u-ca-gregory' : 'en-GB'; %>
<% const readingMinutes = Math.max(1, Math.ceil((article.content || '').replace(/[#*_`>\[\]()]/g, '').trim().split(/\s+/).filter(Boolean).length / 180)); %>
<% const labels = locale === 'fa' ? { article: 'مقاله', minutes: 'دقیقه مطالعه', back: 'بازگشت به مقالات' } : locale === 'ar' ? { article: 'مقال', minutes: 'دقائق للقراءة', back: 'العودة إلى المقالات' } : { article: 'Article', minutes: 'min read', back: 'Back to articles' }; %>
<%
  // The editor often repeats the title as the first heading of the body; the page already shows it.
  const bodyHtml = String(articleHtml || '').replace(/^\s*<h1[^>]*>([\s\S]*?)<\/h1>\s*/, (m, inner) => inner.replace(/<[^>]+>/g, '').trim() === String(article.title).trim() ? '' : m);
%>
<section class="section section--tone-bone page-top">
  <div class="container px-4">
    <header class="article-shell text-center" data-reveal>
      <span class="eyebrow eyebrow--plain justify-center"><%= labels.article %></span>
      <h1 class="section__title mx-auto"><%= article.title %></h1>
      <% if (article.excerpt) { %><p class="section__lead mt-6"><%= article.excerpt %></p><% } %>
      <div class="article-meta mt-7 flex flex-wrap justify-center gap-x-5 gap-y-2">
        <time datetime="<%= new Date(article.createdAt).toISOString() %>"><%= new Date(article.createdAt).toLocaleDateString(localeCode, { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
        <span><%= readingMinutes.toLocaleString(localeCode) %> <%= labels.minutes %></span>
      </div>
    </header>
  </div>
</section>

<section class="section section--tone-ivory">
  <div class="container px-4">
    <div class="article-shell">
      <% if (article.mainImage) { %>
      <figure class="mb-10 overflow-hidden" style="border-radius:var(--r-tight)" data-reveal>
        <img src="<%= img(article.mainImage, 1280) %>"<%- responsive(article.mainImage, [800, 1280, 1600], '(min-width: 1024px) 60vw, 100vw') %> alt="<%= article.title %>" class="w-full h-auto object-cover" loading="eager" fetchpriority="high" decoding="async">
      </figure>
      <% } %>

      <article class="article-body" data-reveal>
        <%- bodyHtml %>
      </article>

      <aside class="article-cta" data-reveal>
        <div>
          <h2 class="article-cta__title"><%= t('pages.articleCtaTitle') %></h2>
          <p class="article-cta__text"><%= t('pages.articleCtaText') %></p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/<%= locale %>/consultation" class="btn btn-brass"><%= t('atelier.consultCta') %></a>
          <a href="/<%= locale %>/products" class="btn btn-outline"><%= t('auto.k_683dfe4e3a38') %></a>
        </div>
      </aside>

      <div class="mt-10">
        <a href="/<%= locale %>/articles"
          class="btn btn-outline btn--sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="icon-back" aria-hidden="true">
            <path d="m12 5 7 7-7 7"></path>
            <path d="M5 12h14"></path>
          </svg>
          <%= labels.back %>
        </a>
      </div>
    </div>
  </div>
</section>
<% } else { %>
<section class="empty-state">
  <div class="container">
    <div class="empty-state__box">
      <h1 class="empty-state__title"><%= t('auto.k_d34e25288c89') %></h1>
      <p class="empty-state__text"><%= t('auto.k_408028b2f208') %></p>
      <div class="empty-state__actions">
        <a href="/<%= locale %>/articles" class="btn btn-solid"><%= t('auto.k_d42bd70857ab') %></a>
      </div>
    </div>
  </div>
</section>
<% } %>
