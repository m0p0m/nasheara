generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id           String    @id @db.VarChar(191)
  name         String    @unique @db.VarChar(191)
  slug         String    @unique @db.VarChar(191)
  description  String?   @db.Text
  mainImage    String?   @db.VarChar(500)
  translations Json?
  products     Product[]
}

model Product {
  id              String           @id @db.VarChar(191)
  slug            String           @unique @db.VarChar(191)
  name            String           @db.VarChar(255)
  categoryId      String?          @db.VarChar(191)
  categoryRecord  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stock           Int?
  description     String?          @db.LongText
  mainImage       String?          @db.VarChar(500)
  galleryImages   Json
  metaTitle       String?          @db.VarChar(255)
  metaDescription String?          @db.Text
  keywords        Json
  isNew           Boolean          @default(false)
  isBestSeller    Boolean          @default(false)
  specs           Json
  patternName     String?          @db.VarChar(191)
  color           String?          @db.VarChar(191)
  material        String?          @db.VarChar(191)
  dimensions      String?          @db.VarChar(191)
  usageArea       Json
  translations    Json?
  tileShape       String?          @db.VarChar(32)
  tileCutout      String?          @db.VarChar(500)
  tileWidthCm     Float?
  tileHeightCm    Float?
  tileVariants    Json?
  tileKind        String?          @db.VarChar(16)
  video           Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  projects        ProjectProduct[]

  @@index([categoryId])
}

model VisualizerScene {
  id           String   @id @db.VarChar(191)
  name         String   @db.VarChar(191)
  nameEn       String?  @db.VarChar(191)
  nameAr       String?  @db.VarChar(191)
  image        String   @db.VarChar(500)
  overlay      String?  @db.VarChar(500)
  quad         Json
  polygon      Json?
  kind         String   @default("wall") @db.VarChar(16)
  wallWidthCm  Float    @default(240)
  wallHeightCm Float    @default(60)
  lighting     Float    @default(0.8)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Project {
  id              String           @id @db.VarChar(191)
  title           String           @db.VarChar(255)
  slug            String           @unique @db.VarChar(191)
  location        String?          @db.VarChar(255)
  description     String?          @db.LongText
  coverImage      String?          @db.VarChar(500)
  galleryImages   Json
  createdAt       DateTime         @default(now())
  translations    Json?
  video           Json?
  relatedProducts ProjectProduct[]
}

model ProjectProduct {
  projectId String  @db.VarChar(100)
  productId String  @db.VarChar(100)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([projectId, productId])
  @@index([productId])
}

model Article {
  id              String   @id @db.VarChar(191)
  title           String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(191)
  content         String   @db.LongText
  excerpt         String?  @db.Text
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  metaKeywords    String?  @db.Text
  published       Boolean  @default(false)
  mainImage       String?  @db.VarChar(500)
  galleryImages   Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  translations    Json?
}

model Consultation {
  id                  String    @id @db.VarChar(191)
  name                String    @db.VarChar(191)
  phone               String    @db.VarChar(50)
  interestedInProduct String?   @db.VarChar(255)
  contactTime         String?   @db.VarChar(191)
  email               String?   @db.VarChar(255)
  projectType         String?   @db.VarChar(191)
  message             String?   @db.LongText
  contacted           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  submittedAt         DateTime?

  @@index([phone])
  @@index([contacted])
}

model NewsletterSubscriber {
  id           String   @id @db.VarChar(191)
  email        String   @unique @db.VarChar(191)
  subscribedAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid()) @db.VarChar(191)
  username     String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid()) @db.VarChar(191)
  name      String   @db.VarChar(191)
  location  String?  @db.VarChar(191)
  text      String   @db.Text
  rating    Int      @default(5)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([published, sortOrder])
}
